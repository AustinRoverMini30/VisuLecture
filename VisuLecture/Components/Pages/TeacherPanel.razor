                NotificationService.Notify(NotificationSeverity.Warning, "Format invalide", 
                    "Veuillez uploader uniquement des fichiers PNG.");
                return;
            }

            themeImages[index] = bytes;
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur upload image thème {index + 1} : " + ex.Message);
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", 
                $"Erreur lors de l'upload de l'image {index + 1} : {ex.Message}");
        }
    }

    private bool CanSaveTheme()
    {
        // Vérifier que le nom n'est pas vide et que les 5 images sont uploadées
        if (string.IsNullOrWhiteSpace(newThemeName)) return false;
        
        for (int i = 0; i < 5; i++)
        {
            if (themeImages[i] == null) return false;
        }
        
        return true;
    }

    private async Task SaveTheme()
    {
        if (!CanSaveTheme())
        {
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", 
                "Veuillez renseigner le nom du thème et uploader les 5 images PNG.");
            return;
        }

        try
        {
            // Générer un ID unique basé sur le prochain ID disponible
            int newId = Themes.Any() ? Themes.Max(t => t.Id) + 1 : 1;
            
            // Créer un nom de dossier basé sur le nom du thème (sans espaces)
            string folderName = newThemeName.Replace(" ", "_").ToLower();
            folderName = new string(folderName.Where(c => char.IsLetterOrDigit(c) || c == '_').ToArray());
            
            // Créer le dossier du thème
            string themePath = Path.Combine(Env.WebRootPath, "pictures", "themes", folderName);
            Directory.CreateDirectory(themePath);
            
            // Enregistrer les 5 images
            for (int i = 0; i < 5; i++)
            {
                string imagePath = Path.Combine(themePath, $"{i + 1}.png");
                await File.WriteAllBytesAsync(imagePath, themeImages[i]);
            }
            
            // Créer le thème dans la base de données
            var newTheme = new Theme(newId, newThemeName, folderName);
            Themes.Add(newTheme);
            Db.Themes.Add(newTheme);
            await Db.SaveChangesAsync();
            
            NotificationService.Notify(NotificationSeverity.Success, "Succès", 
                $"Le thème '{newThemeName}' a été créé avec succès.");
            
            // Réinitialiser le formulaire
            EraseTheme();
            selectedThemeMenu = 1;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la sauvegarde du thème : {ex.Message}");
            NotificationService.Notify(NotificationSeverity.Error, "Erreur", 
                $"Impossible de sauvegarder le thème : {ex.Message}");
        }
    }

    private void EraseTheme()
    {
        newThemeName = "";
        themeImages = new byte[5][];
    }

    private async Task DeleteTheme(Theme theme)
    {
        var confirm = await DialogService.Confirm(
            $"Êtes-vous sûr de vouloir supprimer le thème '{theme.Name}' ?",
            "Confirmer la suppression",
            new ConfirmOptions { OkButtonText = "Oui", CancelButtonText = "Non" }
        );

        if (confirm == true)
        {
            try
            {
                // Supprimer le dossier du thème
                string themePath = Path.Combine(Env.WebRootPath, "pictures", "themes", theme.FolderName);
                if (Directory.Exists(themePath))
                {
                    Directory.Delete(themePath, true);
                }
                
                // Supprimer de la base de données
                Themes.Remove(theme);
                Db.Themes.Remove(theme);
                await Db.SaveChangesAsync();
                
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Suppression réussie",
                    Detail = $"Le thème '{theme.Name}' a été supprimé.",
                    Duration = 4000
                });
            }
            catch (Exception ex)
            {
                Console.WriteLine($"Erreur lors de la suppression : {ex.Message}");
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erreur de suppression",
                    Detail = $"Impossible de supprimer le thème : {ex.Message}",
                    Duration = 5000
                });
            }
        }
    }


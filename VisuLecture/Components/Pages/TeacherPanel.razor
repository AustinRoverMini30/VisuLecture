    private void CleanupOrphanedTextFolders()
    {
        try
        {
            string textImgPath = Path.Combine("wwwroot", "textImg");
            
            if (!Directory.Exists(textImgPath))
            {
                Console.WriteLine("Dossier textImg introuvable.");
                return;
            }
            
            // Récupérer tous les IDs valides depuis la base de données
            var validIds = Db.TextRecords.Select(tr => tr.Id).ToHashSet();
            
            // Parcourir tous les sous-dossiers de textImg
            var directories = Directory.GetDirectories(textImgPath);
            int deletedCount = 0;
            
            foreach (var directory in directories)
            {
                string folderName = Path.GetFileName(directory);
                
                // Vérifier si le dossier correspond à un ID dans la DB
                if (!validIds.Contains(folderName))
                {
                    try
                    {
                        Directory.Delete(directory, true); // true = récursif
                        deletedCount++;
                        Console.WriteLine($"Dossier orphelin supprimé : {folderName}");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Erreur lors de la suppression de {folderName} : {ex.Message}");
                    }
                }
            }
            
            if (deletedCount > 0)
            {
                Console.WriteLine($"Nettoyage terminé : {deletedCount} dossier(s) orphelin(s) supprimé(s).");
            }
            else
            {
                Console.WriteLine("Aucun dossier orphelin détecté.");
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du nettoyage des dossiers orphelins : {ex.Message}");
        }
    }
    

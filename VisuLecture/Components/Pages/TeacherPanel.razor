    private async Task InstallPythonDependencies()
    {
        PythonInstallStatus = "Installation en cours...";
        PythonInstallOutput = "";
        await InvokeAsync(StateHasChanged);
        
        try
        {
            // Chemin vers requirements.txt
            string requirementsPath = Path.Combine(Env.ContentRootPath, "requirements.txt");
            
            if (!File.Exists(requirementsPath))
            {
                PythonInstallStatus = "Erreur d'installation";
                PythonInstallOutput = $"Erreur : Le fichier requirements.txt n'a pas été trouvé à l'emplacement :\n{requirementsPath}";
                await InvokeAsync(StateHasChanged);
                return;
            }

            var psi = new ProcessStartInfo
            {
                FileName = "pip",
                Arguments = $"install -r \"{requirementsPath}\" --upgrade",
                RedirectStandardOutput = true,
                RedirectStandardError = true,
                UseShellExecute = false,
                CreateNoWindow = true,
                WorkingDirectory = Env.ContentRootPath
            };

            var process = new Process { StartInfo = psi };
            var output = new StringBuilder();
            var error = new StringBuilder();

            process.OutputDataReceived += (sender, e) =>
            {
                if (!string.IsNullOrEmpty(e.Data))
                {
                    output.AppendLine(e.Data);
                    PythonInstallOutput = output.ToString();
                    InvokeAsync(StateHasChanged);
                }
            };

            process.ErrorDataReceived += (sender, e) =>
            {
                if (!string.IsNullOrEmpty(e.Data))
                {
                    error.AppendLine(e.Data);
                }
            };

            process.Start();
            process.BeginOutputReadLine();
            process.BeginErrorReadLine();
            await process.WaitForExitAsync();

            if (process.ExitCode == 0)
            {
                PythonInstallStatus = "Installation réussie";
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Success,
                    Summary = "Installation réussie",
                    Detail = "Les dépendances Python ont été installées/mises à jour avec succès.",
                    Duration = 4000
                });
                
                // Vérifier automatiquement l'état des modules après installation
                await CheckPythonModules();
            }
            else
            {
                PythonInstallStatus = "Erreur d'installation";
                PythonInstallOutput = $"=== SORTIE ===\n{output}\n\n=== ERREURS ===\n{error}";
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Error,
                    Summary = "Erreur d'installation",
                    Detail = "Une erreur s'est produite lors de l'installation des dépendances Python.",
                    Duration = 5000
                });
            }
        }
        catch (Exception ex)
        {
            PythonInstallStatus = "Erreur d'installation";
            PythonInstallOutput = $"Exception : {ex.Message}\n\nStack Trace:\n{ex.StackTrace}";
            Console.WriteLine($"Erreur lors de l'installation Python : {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur système",
                Detail = $"Impossible d'exécuter pip : {ex.Message}",
                Duration = 5000
            });
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task CheckPythonModules()
    {
        isCheckingModules = true;
        pythonModules.Clear();
        await InvokeAsync(StateHasChanged);
        
        try
        {
            // Lire le fichier requirements.txt
            string requirementsPath = Path.Combine(Env.ContentRootPath, "requirements.txt");
            
            if (!File.Exists(requirementsPath))
            {
                NotificationService.Notify(new NotificationMessage
                {
                    Severity = NotificationSeverity.Warning,
                    Summary = "Fichier introuvable",
                    Detail = "Le fichier requirements.txt n'existe pas.",
                    Duration = 4000
                });
                isCheckingModules = false;
                hasCheckedModules = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Lire les modules depuis requirements.txt
            var lines = await File.ReadAllLinesAsync(requirementsPath);
            var moduleNames = lines
                .Where(line => !string.IsNullOrWhiteSpace(line) && !line.Trim().StartsWith("#") && line.Trim().ToUpper() != "UNKNOWN")
                .Select(line => line.Split(new[] { "==", ">=", "<=", "~=", "!=" }, StringSplitOptions.None)[0].Trim())
                .ToList();

            if (!moduleNames.Any())
            {
                isCheckingModules = false;
                hasCheckedModules = true;
                await InvokeAsync(StateHasChanged);
                return;
            }

            // Vérifier chaque module avec pip show
            foreach (var moduleName in moduleNames)
            {
                var module = new PythonModule { Name = moduleName };
                
                var psi = new ProcessStartInfo
                {
                    FileName = "pip",
                    Arguments = $"show {moduleName}",
                    RedirectStandardOutput = true,
                    RedirectStandardError = true,
                    UseShellExecute = false,
                    CreateNoWindow = true
                };

                try
                {
                    var process = Process.Start(psi);
                    if (process != null)
                    {
                        string output = await process.StandardOutput.ReadToEndAsync();
                        await process.WaitForExitAsync();

                        // Si la commande réussit et retourne des informations, le module est installé
                        if (process.ExitCode == 0 && !string.IsNullOrWhiteSpace(output))
                        {
                            module.IsInstalled = true;
                            
                            // Extraire la version
                            var versionLine = output.Split('\n')
                                .FirstOrDefault(line => line.StartsWith("Version:", StringComparison.OrdinalIgnoreCase));
                            if (versionLine != null)
                            {
                                module.Version = versionLine.Split(':')[1].Trim();
                            }
                        }
                        else
                        {
                            module.IsInstalled = false;
                        }
                    }
                }
                catch
                {
                    module.IsInstalled = false;
                }

                pythonModules.Add(module);
                await InvokeAsync(StateHasChanged);
            }

            hasCheckedModules = true;
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de la vérification des modules : {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail = $"Impossible de vérifier les modules : {ex.Message}",
                Duration = 5000
            });
        }
        finally
        {
            isCheckingModules = false;
            await InvokeAsync(StateHasChanged);
        }
    }


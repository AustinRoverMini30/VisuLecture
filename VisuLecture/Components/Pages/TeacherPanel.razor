    private async Task OnImageSelected(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            const long maxSize = 10 * 1024 * 1024; // 10MB

            using var ms = new MemoryStream();
            await file.OpenReadStream(maxSize).CopyToAsync(ms);
            var rawBytes = ms.ToArray();

            // Normaliser en PNG (et resize type 1920x1080 comme ton generator)
            var pngBytes = NormalizeToPng(rawBytes, targetWidth: 1920, targetHeight: 1080);

            uploadedImageBytes = pngBytes;
            imageBase64 = Convert.ToBase64String(pngBytes);

            await AnalyserImage(pngBytes);

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur upload image : " + ex.Message);
        }
    }

    private async Task ReRunOcrOnCurrentImage()

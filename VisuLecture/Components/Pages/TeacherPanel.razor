    private byte[] NormalizeToPng(byte[] inputBytes, int? targetWidth = null, int? targetHeight = null)
    {
        using var input = SKBitmap.Decode(inputBytes);
        if (input == null)
            return inputBytes;

        SKBitmap bmpToSave = input;

        if (targetWidth.HasValue && targetHeight.HasValue &&
            (input.Width != targetWidth.Value || input.Height != targetHeight.Value))
        {
            var resized = new SKBitmap(targetWidth.Value, targetHeight.Value);
            using var canvas = new SKCanvas(resized);
            canvas.Clear(SKColors.White);

            var scale = Math.Min(
                targetWidth.Value / (float)input.Width,
                targetHeight.Value / (float)input.Height
            );

            var newW = (int)(input.Width * scale);
            var newH = (int)(input.Height * scale);
            var x = (targetWidth.Value - newW) / 2;
            var y = (targetHeight.Value - newH) / 2;

            var dest = new SKRect(x, y, x + newW, y + newH);
            canvas.DrawBitmap(input, dest);

            bmpToSave = resized;
        }

        using var img = SKImage.FromBitmap(bmpToSave);
        using var data = img.Encode(SKEncodedImageFormat.Png, 100);
        return data.ToArray();
    }

    // =========================
    // OCR (inchangé)
    // =========================
    private async Task<bool> AnalyserImage(byte[] imageBytes)
{
    try
    {
        string tessDataPath = @"C:\Program Files\Tesseract-OCR\tessdata";

        // ✅ Vérifs explicites (sinon tu exportes un CSV vide sans comprendre)
        if (!Directory.Exists(tessDataPath))
            throw new DirectoryNotFoundException($"tessdata introuvable : {tessDataPath}");

        if (!File.Exists(Path.Combine(tessDataPath, "fra.traineddata")))
            throw new FileNotFoundException($"fra.traineddata introuvable dans : {tessDataPath}");

        resultats.Clear();

        var symbols = new HashSet<string>
        {
            "?", "!", ".", ",", ";", ":", "\"", "«", "»", "(", ")", "[", "]", "{", "}", "_", "—", "…", "/", "\\", "|"
        };

        using var engine = new TesseractEngine(tessDataPath, "fra", EngineMode.Default);

        using var pix = Pix.LoadFromMemory(imageBytes);
        using var page = engine.Process(pix);

        // ✅ Ultra utile pour debug : si ça retourne vide => OCR KO / image KO
        var fullText = page.GetText();
        Console.WriteLine("Tesseract full text:");
        Console.WriteLine(fullText);

        using var iter = page.GetIterator();
        iter.Begin();

        int lineNum = 0;
        float prevRight = 0;
        float espace = 0;

        do
        {
            if (iter.IsAtBeginningOf(PageIteratorLevel.TextLine))
            {
                lineNum++;
                prevRight = 0;
            }

            if (iter.TryGetBoundingBox(PageIteratorLevel.Word, out var rect))
            {
                string mot = iter.GetText(PageIteratorLevel.Word)?.Trim() ?? "";
                float conf = iter.GetConfidence(PageIteratorLevel.Word) * 100;

                string motNettoye = new string(mot.Where(c => !symbols.Contains(c.ToString())).ToArray());
                if (string.IsNullOrWhiteSpace(motNettoye))
                    continue;

                if (prevRight > 0)
                {
                    espace = rect.X1 - prevRight;
                    if (espace < 0) espace = rect.X1 / 2f;
                }
                else
                {
                    espace = 0;
                }

                resultats.Add(new ResultatOCR
                {
                    Mot = motNettoye,
                    X = (int)(rect.X1 - (espace / 2f)),
                    Y = rect.Y1,
                    Largeur = (int)(rect.Width + espace),
                    Hauteur = rect.Height,
                    Ligne = lineNum,
                    Espace = (int)espace,
                    Confiance = (int)conf
                });

                prevRight = rect.X2;
            }

        } while (iter.Next(PageIteratorLevel.Word));

        Console.WriteLine($"OCR terminé: {resultats.Count} mots détectés.");

        if (resultats.Count == 0)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "OCR vide",
                Detail = "Tesseract n’a détecté aucun mot (image trop petite/floue, mauvais contraste, rotation, etc.).",
                Duration = 6000
            });
        }

        await Task.CompletedTask;
        return resultats.Count > 0;
    }
    catch (Exception ex)
    {
        Console.WriteLine("Erreur OCR : " + ex);

        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Error,
            Summary = "Erreur OCR",
            Detail = ex.Message,
            Duration = 8000
        });

        return false;
    }
}



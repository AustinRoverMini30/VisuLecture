@page "/teacher-panel"
@using System.Diagnostics
@using System.Text
@using Microsoft.AspNetCore.Components.Forms
@inject IJSRuntime JS
@rendermode InteractiveServer
@using System.Timers;
@using Microsoft.EntityFrameworkCore
@using SkiaSharp
@using Tesseract
@using VisuLecture.Components.Controller
@using VisuLecture.Components.Model
@using Theme = VisuLecture.Components.Model.Theme
@using Orientation = Radzen.Orientation
@inject DialogService DialogService
@inject NavigationManager Navigation
@inject AppDbContext Db
@inject IWebHostEnvironment Env
@inject CalibrationService CalibrationService
@inject NotificationService NotificationService

<div class="teacher-panel-container">
    
    <!-- Hero Section -->
    <section class="teacher-hero">
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <h1 class="page-title">
                <RadzenIcon Icon="dashboard" style="margin-right: 15px; font-size: inherit;" />
                Panneau Enseignant
            </h1>
            <p class="page-subtitle">Gérez vos élèves, textes et surveillez l'état du système</p>
        </div>
    </section>

    <!-- BeamEye Status Section -->
    <section class="status-section">
        <div class="section-container">
            <div class="status-card">
                <div class="status-header">
                    <div class="status-icon">
                        <img src="/pictures/beam.png" alt="BeamEye" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                    <div class="status-info">
                        <h3 class="status-title">État BeamEye Tracker</h3>
                        <p class="status-description">Surveillance du système d'eye-tracking</p>
                    </div>
                </div>
                
                <div class="status-content">
                    @if (BeamStatus == "En cours")
                    {
                        <div class="status-display running">
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text=@BeamStatus class="custom-badge"></RadzenBadge>
                            <div class="status-buttons">
                                <RadzenButton Click="@RestartBeam" class="btn-restart">
                                    <RadzenIcon Icon="refresh" /> Redémarrer
                                </RadzenButton>
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="@StopBeam" class="btn-stop">
                                    <RadzenIcon Icon="stop" /> Arrêter
                                </RadzenButton>
                            </div>
                        </div>
                    }
                    else if (BeamStatus == "Redémarrage..." || BeamStatus == "Arrêt en cours..." || BeamStatus == "Démarrage en cours...")
                    {
                        <div class="status-display loading">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="15px" AlignItems="AlignItems.Center">
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text=@BeamStatus class="custom-badge"></RadzenBadge>
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" AriaLabel="Loading"/>
                            </RadzenStack>
                        </div>
                    }
                    else
                    {
                        <div class="status-display stopped">
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text=@BeamStatus class="custom-badge"></RadzenBadge>
                            <RadzenButton Click="@StartBeam" class="btn-start">
                                <RadzenIcon Icon="play_arrow" /> Démarrer
                            </RadzenButton>
                        </div>
                    }
                </div>
            </div>
        </div>
    </section>

    <!-- Python Dependencies Section -->
    <section class="python-section">
        <div class="section-container">
            <div class="status-card">
                <div class="status-header">
                    <div class="status-icon">
                        <img src="/pictures/python.png" alt="Python" style="width: 100%; height: 100%; object-fit: contain;" />
                    </div>
                    <div class="status-info">
                        <h3 class="status-title">Dépendances Python</h3>
                        <p class="status-description">Installation et mise à jour des modules Python requis</p>
                    </div>
                </div>
                
                <div class="status-content">
                    @if (PythonInstallStatus == "Installation en cours...")
                    {
                        <div class="status-display loading">
                            <RadzenStack Orientation="Orientation.Horizontal" Gap="15px" AlignItems="AlignItems.Center">
                                <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text=@PythonInstallStatus class="custom-badge"></RadzenBadge>
                                <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.Small" AriaLabel="Loading"/>
                            </RadzenStack>
                            @if (!string.IsNullOrEmpty(PythonInstallOutput))
                            {
                                <div class="install-output">
                                    <pre>@PythonInstallOutput</pre>
                                </div>
                            }
                        </div>
                    }
                    else if (PythonInstallStatus == "Installation réussie")
                    {
                        <div class="status-display running">
                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text=@PythonInstallStatus class="custom-badge"></RadzenBadge>
                            <RadzenButton Click="@InstallPythonDependencies" class="btn-start">
                                <RadzenIcon Icon="refresh" /> Réinstaller
                            </RadzenButton>
                        </div>
                    }
                    else if (PythonInstallStatus == "Erreur d'installation")
                    {
                        <div class="status-display stopped">
                            <RadzenBadge BadgeStyle="BadgeStyle.Danger" Text=@PythonInstallStatus class="custom-badge"></RadzenBadge>
                            <RadzenButton Click="@InstallPythonDependencies" class="btn-start">
                                <RadzenIcon Icon="play_arrow" /> Réessayer
                            </RadzenButton>
                        </div>
                        @if (!string.IsNullOrEmpty(PythonInstallOutput))
                        {
                            <div class="install-output error">
                                <pre>@PythonInstallOutput</pre>
                            </div>
                        }
                    }
                    else
                    {
                        <div class="status-display stopped">
                            <RadzenBadge BadgeStyle="BadgeStyle.Info" Text="Prêt" class="custom-badge"></RadzenBadge>
                            <RadzenButton Click="@InstallPythonDependencies" class="btn-start">
                                <RadzenIcon Icon="play_arrow" /> Installer / Mettre à jour
                            </RadzenButton>
                        </div>
                    }
                    
                    <!-- Module Status Section -->
                    <div class="module-status-section">
                        <div class="module-status-header">
                            <h4 class="module-status-title">
                                <RadzenIcon Icon="list" style="margin-right: 8px;" />
                                État des modules
                            </h4>
                            <RadzenButton Click="@CheckPythonModules" 
                                        Size="ButtonSize.Small" 
                                        ButtonStyle="ButtonStyle.Light"
                                        Disabled="@isCheckingModules"
                                        class="btn-check-modules">
                                @if (isCheckingModules)
                                {
                                    <RadzenProgressBarCircular ShowValue="false" Mode="ProgressBarMode.Indeterminate" Size="ProgressBarCircularSize.ExtraSmall" />
                                    <span style="margin-left: 8px;">Vérification...</span>
                                }
                                else
                                {
                                    <RadzenIcon Icon="refresh" />
                                    <span style="margin-left: 8px;">Vérifier</span>
                                }
                            </RadzenButton>
                        </div>
                        
                        @if (pythonModules.Any())
                        {
                            <div class="modules-list">
                                @foreach (var module in pythonModules)
                                {
                                    <div class="module-item @(module.IsInstalled ? "installed" : "not-installed")">
                                        <div class="module-info">
                                            <RadzenIcon Icon="@(module.IsInstalled ? "check_circle" : "cancel")" 
                                                      class="module-status-icon" />
                                            <span class="module-name">@module.Name</span>
                                            @if (!string.IsNullOrEmpty(module.Version))
                                            {
                                                <span class="module-version">@module.Version</span>
                                            }
                                        </div>
                                        <RadzenBadge BadgeStyle="@(module.IsInstalled ? BadgeStyle.Success : BadgeStyle.Danger)" 
                                                   Text="@(module.IsInstalled ? "Installé" : "Non installé")" 
                                                   class="module-badge" />
                                    </div>
                                }
                            </div>
                        }
                        else if (hasCheckedModules)
                        {
                            <div class="no-modules-message">
                                <RadzenIcon Icon="info" style="font-size: 24px; color: #999; margin-bottom: 8px;" />
                                <p>Aucun module trouvé dans requirements.txt</p>
                            </div>
                        }
                        else
                        {
                            <div class="no-modules-message">
                                <RadzenIcon Icon="visibility" style="font-size: 24px; color: #999; margin-bottom: 8px;" />
                                <p>Cliquez sur "Vérifier" pour voir l'état des modules</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Students Section -->
    <section class="students-section">
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">
                    <RadzenIcon Icon="group" style="margin-right: 10px;" />
                    Gestion des élèves
                </h2>
                <p class="section-description">Gérez vos élèves et consultez leurs enregistrements</p>
            </div>
            
            <div class="student-toggle">
                <RadzenSelectBar TValue="int" Size="ButtonSize.Medium" @bind-Value="@selectedStudentMenu" class="custom-toggle">
                    <Items>
                        <RadzenSelectBarItem Value="1" Text="👥 Enregistrés" />
                        <RadzenSelectBarItem Value="2" Text="➕ Nouveau" />
                    </Items>
                </RadzenSelectBar>
            </div>

            <!-- Boutons Import/Export CSV -->
            <div class="csv-actions" style="display: flex; justify-content: center; gap: 1rem; margin-bottom: 2rem;">
                <RadzenButton ButtonStyle="ButtonStyle.Info" 
                            Click="@ExportStudentsToCSV"
                            Disabled="@(!Students.Any())"
                            class="btn-csv">
                    <RadzenIcon Icon="download" /> Exporter en CSV
                </RadzenButton>
                <label class="btn-csv-import-label">
                    <RadzenIcon Icon="upload_file" /> Importer CSV
                    <InputFile OnChange="@ImportStudentsFromCSV" accept=".csv" style="display: none;" />
                </label>
            </div>

            @if (selectedStudentMenu == 2)
            {
                <div class="new-student-container animate-fade-in">
                    <div class="new-student-card">
                        <h3 class="card-title">
                            <RadzenIcon Icon="person_add" />
                            Créer un nouvel élève
                        </h3>
                        
                        <RadzenTemplateForm TItem="Student" Data=@newStudentModel Submit=@OnStudentSubmit InvalidSubmit=@OnStudentInvalidSubmit>
                            <RadzenStack Gap="1rem" class="rz-p-sm-12">
                                
                                <!-- First Name -->
                                <RadzenFormField Text="Prénom">
                                    <ChildContent>
                                        <RadzenTextBox Name="FirstName" @bind-Value=@newStudentModel.FirstName class="form-input" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="FirstName" Text="Le prénom est requis." />
                                    </Helper>
                                </RadzenFormField>
                                
                                <!-- Last Name -->
                                <RadzenFormField Text="Nom de famille">
                                    <ChildContent>
                                        <RadzenTextBox Name="LastName" @bind-Value=@newStudentModel.LastName class="form-input" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="LastName" Text="Le nom de famille est requis." />
                                    </Helper>
                                </RadzenFormField>
                                
                                <!-- Age -->
                                <RadzenFormField Text="Âge">
                                    <ChildContent>
                                        <RadzenNumeric Name="Age" @bind-Value=@newStudentModel.Age Min="0" Max="120" class="form-input" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Age" Text="L'âge est requis." />
                                    </Helper>
                                </RadzenFormField>
                                
                                <!-- Lunette -->
                                <RadzenFormField Text="Porte des lunettes ?">
                                    <ChildContent>
                                        <RadzenRadioButtonList Name="Lunette" @bind-Value=@newStudentModel.Lunette TValue="int">
                                            <Items>
                                                <RadzenRadioButtonListItem Text="Non" Value="1" />
                                                <RadzenRadioButtonListItem Text="Oui" Value="2" />
                                            </Items>
                                        </RadzenRadioButtonList>
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Lunette" Text="Champ obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                                
                                <!-- Theme -->
                                <RadzenFormField Text="Thème préféré">
                                    <ChildContent>
                                        <RadzenDropDown Name="Theme" 
                                                      @bind-Value=@newStudentModel.Theme 
                                                      Data=@GetThemeOptions()
                                                      TextProperty="Text"
                                                      ValueProperty="Value"
                                                      TValue="int"
                                                      class="form-input" />
                                    </ChildContent>
                                    <Helper>
                                        <RadzenRequiredValidator Component="Theme" Text="Champ obligatoire." />
                                    </Helper>
                                </RadzenFormField>
                                
                                <!-- Remarque -->
                                <RadzenFormField Text="Remarque (optionnel)">
                                    <ChildContent>
                                        <RadzenTextArea Name="Remarque" @bind-Value=@newStudentModel.Remarque Rows="3" class="form-textarea" Placeholder="Ajoutez une remarque (optionnel)..." />
                                    </ChildContent>
                                </RadzenFormField>
                                
                                <!-- Actions -->
                                <div class="form-actions">
                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                                Click=@EraseStudent 
                                                ButtonType="ButtonType.Button"
                                                class="btn-action">
                                        <RadzenIcon Icon="delete" /> Effacer
                                    </RadzenButton>
                                    <RadzenButton ButtonType="ButtonType.Submit" 
                                                ButtonStyle="ButtonStyle.Success"
                                                class="btn-action btn-save">
                                        <RadzenIcon Icon="check" /> Enregistrer
                                    </RadzenButton>
                                </div>
                                
                            </RadzenStack>
                        </RadzenTemplateForm>
                    </div>
                </div>
            }
            else
            {
                <div class="students-grid">
                @foreach (var student in Students)
                {
                    <div class="student-card animate-fade-in">
                        <div class="student-header">
                            <div class="student-avatar">
                                @student.FirstName.Substring(0, 1)@student.LastName.Substring(0, 1)
                            </div>
                            <div class="student-info">
                                <h3 class="student-name">@student.FirstName @student.LastName</h3>
                                <p class="student-id">ID: @student.Id.Substring(0, 8)...</p>
                            </div>
                        </div>
                        
                        <div class="student-actions">
                            @if (CalibrationService.clientId == student.Id)
                            {
                                <div class="processing-indicator">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Warning" Text="En cours de traitement" class="custom-badge"></RadzenBadge>
                                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Warning" Value="100" Size="ProgressBarCircularSize.Small" ShowValue="false" Mode="ProgressBarMode.Indeterminate" AriaLabel="Processing" />
                                </div>
                            }
                            else if (ContainsId(student.Id))
                            {
                                <div class="processing-indicator">
                                    <RadzenBadge BadgeStyle="BadgeStyle.Base" Text="En attente" class="custom-badge"></RadzenBadge>
                                    <RadzenProgressBarCircular ProgressBarStyle="ProgressBarStyle.Base" Value="100" Size="ProgressBarCircularSize.Small" ShowValue="false" Mode="ProgressBarMode.Indeterminate" AriaLabel="Waiting" />
                                </div>
                            }
                            else
                            {
                                var readings = Db.Readings.Where(r => r.StudentId == student.Id).Include(r => r.TextRecord).ToList();
                                
                                <div class="action-buttons">
                                    @if (readings.Any())
                                    {
                                        <RadzenButton ButtonStyle="ButtonStyle.Info" Click="args => ShowReadings(student, readings)" class="btn-consult">
                                            <RadzenIcon Icon="visibility" style="margin-right: 4px;" />
                                            Consulter (@readings.Count)
                                        </RadzenButton>
                                    }
                                    <RadzenButton ButtonStyle="ButtonStyle.Secondary" Click="args => Modify(student)" class="btn-modify">
                                        <RadzenIcon Icon="edit" />
                                    </RadzenButton>
                                    <RadzenButton ButtonStyle="ButtonStyle.Danger" Click="args => Delete(student)" class="btn-delete">
                                        <RadzenIcon Icon="delete" />
                                    </RadzenButton>
                                </div>
                            }
                        </div>
                    </div>
                }
                
                @if (!Students.Any())
                {
                    <div class="empty-state">
                        <RadzenIcon Icon="person_add" style="font-size: 4rem; color: #ccc; margin-bottom: 1rem;" />
                        <p class="empty-text">Aucun élève enregistré</p>
                        <p class="empty-subtext">Créez votre premier élève en cliquant sur "Nouveau"</p>
                    </div>
                }
            </div>
            }
        </div>
    </section>

    <!-- Texts Section -->
    <section class="texts-section">
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">
                    <RadzenIcon Icon="description" style="margin-right: 10px;" />
                    Textes de lecture
                </h2>
                <p class="section-description">Créez et gérez vos textes pour les sessions de lecture</p>
            </div>
            
            <div class="text-toggle">
                <RadzenSelectBar TValue="int" Size="ButtonSize.Medium" @bind-Value="@selectedTextMenu" class="custom-toggle">
                    <Items>
                        <RadzenSelectBarItem Value="1" Text="📚 Enregistrés" />
                        <RadzenSelectBarItem Value="2" Text="➕ Nouveau" />
                    </Items>
                </RadzenSelectBar>
            </div>

            @if (selectedTextMenu == 2)
            {
                <div class="new-text-container animate-fade-in">
                    <div class="new-text-card">
                        <h3 class="card-title">
                            <RadzenIcon Icon="note_add" />
                            Créer un nouveau texte
                        </h3>

                        <!-- NOUVEAU: mode Texte / Image -->
                        <div class="text-toggle" style="margin-bottom: 1rem;">
                            <RadzenSelectBar TValue="int" Size="ButtonSize.Medium" @bind-Value="@selectedInputMode" class="custom-toggle">
                                <Items>
                                    <RadzenSelectBarItem Value="1" Text="✍️ Texte" />
                                    <RadzenSelectBarItem Value="2" Text="🖼️ Image" />
                                </Items>
                            </RadzenSelectBar>
                        </div>

                        <div class="form-group">
                            <label class="form-label">Nom</label>
                            <RadzenTextBox Placeholder="Ex: Lecture du jour, Poème..."
                                           ValueChanged=@(args => OnChangeTextTitle(args))
                                           class="form-input" />
                        </div>

                        @if (selectedInputMode == 1)
                        {
                            <!-- MODE TEXTE -->
                            <div class="form-group">
                                <label class="form-label">Contenu du texte</label>
                                <RadzenTextArea Placeholder="Saisissez votre texte ici..."
                                                Rows="12"
                                                ValueChanged=@(args => OnChangeTextContent(args))
                                                class="form-textarea" />
                            </div>

                            @if (string.IsNullOrEmpty(imageBase64))
                            {
                                <div class="form-actions">
                                    <RadzenButton ButtonStyle="ButtonStyle.Success"
                                                  Click=@GenererImage
                                                  class="btn-action btn-generate">
                                        <RadzenIcon Icon="image" /> Générer le texte
                                    </RadzenButton>
                                </div>
                            }
                        }
                        else
                        {
                            <!-- MODE IMAGE -->
                            <div class="form-group">
                                <label class="form-label">Importer une image</label>
                                <InputFile OnChange="OnImageSelected" accept="image/*" />
                                <p style="margin-top: .5rem; color:#666; font-size:.9rem;">
                                    Conseil : texte noir sur fond clair (PNG/JPG).
                                </p>
                            </div>
                        }

                        @if (!string.IsNullOrEmpty(imageBase64))
                        {
                            <div class="text-preview">
                                <h4 class="preview-title">Aperçu</h4>
                                <RadzenImage Path="@($"data:image/png;base64,{imageBase64}")"
                                             AlternateText="Aperçu du texte"
                                             class="preview-image" />
                            </div>

                            <div class="form-actions">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                              Click=@EraseText
                                              class="btn-action">
                                    <RadzenIcon Icon="delete" /> Effacer
                                </RadzenButton>

                                @if (selectedInputMode == 1)
                                {
                                    <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                                                  Click=@GenererImage
                                                  class="btn-action">
                                        <RadzenIcon Icon="refresh" /> Regénérer
                                    </RadzenButton>
                                }
                                else
                                {
                                    <RadzenButton ButtonStyle="ButtonStyle.Secondary"
                                                  Click=@ReRunOcrOnCurrentImage
                                                  class="btn-action">
                                        <RadzenIcon Icon="refresh" /> Relancer OCR
                                    </RadzenButton>
                                }

                                <RadzenButton ButtonStyle="ButtonStyle.Success"
                                              Click=@SaveText
                                              class="btn-action btn-save">
                                    <RadzenIcon Icon="check" /> Enregistrer
                                </RadzenButton>
                            </div>
                        }
                    </div>
                </div>
            }
            else
            {
                <div class="texts-grid">
                    @foreach (var textR in TextRecords)
                    {
                        <div class="text-card animate-fade-in">
                            <div class="text-card-header">
                                <h3 class="text-card-title">@textR.Name</h3>
                            </div>
                            <div class="text-card-image">
                                <RadzenImage Path="@(textR.FilePath+"/image.png")" 
                                           AlternateText=@textR.Name 
                                           Style="width: 100%; border-radius: 8px;" />
                            </div>
                            <div class="text-card-footer">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                            Click="args => DeleteText(textR)"
                                            class="btn-delete-text">
                                    <RadzenIcon Icon="delete" /> Supprimer
                                </RadzenButton>
                            </div>
                        </div>
                    }
                    
                    @if (!TextRecords.Any())
                    {
                        <div class="empty-state">
                            <RadzenIcon Icon="description" style="font-size: 4rem; color: #ccc; margin-bottom: 1rem;" />
                            <p class="empty-text">Aucun texte enregistré</p>
                            <p class="empty-subtext">Créez votre premier texte en cliquant sur "Nouveau"</p>
                        </div>
                    }
                </div>
            }
        </div>
    </section>

    <!-- Themes Section -->
    <section class="themes-section">
        <div class="section-container">
            <div class="section-header">
                <h2 class="section-title">
                    <RadzenIcon Icon="palette" style="margin-right: 10px;" />
                    Gestion des thèmes
                </h2>
                <p class="section-description">Créez et gérez les thèmes visuels pour les élèves (5 images PNG par thème)</p>
            </div>
            
            <div class="theme-toggle">
                <RadzenSelectBar TValue="int" Size="ButtonSize.Medium" @bind-Value="@selectedThemeMenu" class="custom-toggle">
                    <Items>
                        <RadzenSelectBarItem Value="1" Text="🎨 Enregistrés" />
                        <RadzenSelectBarItem Value="2" Text="➕ Nouveau" />
                    </Items>
                </RadzenSelectBar>
            </div>

            @if (selectedThemeMenu == 2)
            {
                <div class="new-theme-container animate-fade-in">
                    <div class="new-theme-card">
                        <h3 class="card-title">
                            <RadzenIcon Icon="add_photo_alternate" />
                            Créer un nouveau thème
                        </h3>

                        <div class="form-group">
                            <label class="form-label">Nom du thème</label>
                            <RadzenTextBox Placeholder="Ex: Animaux, Espace, Nature..."
                                           @bind-Value="@newThemeName"
                                           class="form-input" />
                        </div>

                        <div class="theme-images-upload">
                            <p class="upload-instructions">
                                <RadzenIcon Icon="info" style="margin-right: 5px;" />
                                Importez 5 images PNG pour ce thème (seront numérotées 1.png à 5.png)
                            </p>
                            
                            @for (int i = 0; i < 5; i++)
                            {
                                int index = i; // Capture de variable pour le lambda
                                <div class="image-upload-slot">
                                    <label class="upload-label">Image @(i + 1)</label>
                                    <InputFile OnChange="@(e => OnThemeImageSelected(e, index))" 
                                             accept="image/png" 
                                             class="file-input" />
                                    @if (themeImages[i] != null)
                                    {
                                        <div class="image-preview-small">
                                            <img src="@($"data:image/png;base64,{Convert.ToBase64String(themeImages[i])}")" 
                                                 alt="Aperçu @(i + 1)" />
                                            <RadzenBadge BadgeStyle="BadgeStyle.Success" Text="✓" class="upload-badge" />
                                        </div>
                                    }
                                    else
                                    {
                                        <div class="image-placeholder-small">
                                            <RadzenIcon Icon="cloud_upload" />
                                        </div>
                                    }
                                </div>
                            }
                        </div>

                        <div class="form-actions">
                            <RadzenButton ButtonStyle="ButtonStyle.Danger"
                                          Click="@EraseTheme"
                                          class="btn-action">
                                <RadzenIcon Icon="delete" /> Effacer
                            </RadzenButton>

                            <RadzenButton ButtonStyle="ButtonStyle.Success"
                                          Click="@SaveTheme"
                                          Disabled="@(!CanSaveTheme())"
                                          class="btn-action">
                                <RadzenIcon Icon="save" /> Enregistrer
                            </RadzenButton>
                        </div>
                    </div>
                </div>
            }
            else
            {
                <div class="themes-grid">
                    @foreach (var theme in Themes)
                    {
                        <div class="theme-card">
                            <div class="theme-card-header">
                                <h4 class="theme-card-title">@theme.Name</h4>
                                <span class="theme-id-badge">ID: @theme.Id</span>
                            </div>
                            <div class="theme-card-images">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    <div class="theme-image-mini">
                                        <img src="@($"/pictures/themes/{theme.FolderName}/{i}.png")" 
                                             alt="@theme.Name @i" 
                                             onerror="this.src='/pictures/placeholder.png'" />
                                    </div>
                                }
                            </div>
                            <div class="theme-card-footer">
                                <RadzenButton ButtonStyle="ButtonStyle.Danger" 
                                            Click="@(() => DeleteTheme(theme))"
                                            class="btn-delete-theme">
                                    <RadzenIcon Icon="delete" /> Supprimer
                                </RadzenButton>
                            </div>
                        </div>
                    }
                    
                    @if (!Themes.Any())
                    {
                        <div class="empty-state">
                            <RadzenIcon Icon="palette" style="font-size: 4rem; color: #ccc; margin-bottom: 1rem;" />
                            <p class="empty-text">Aucun thème enregistré</p>
                            <p class="empty-subtext">Créez votre premier thème en cliquant sur "Nouveau"</p>
                        </div>
                    }
                </div>
            }
        </div>
    </section>
</div>


@code {
    // Classe pour représenter un module Python
    public class PythonModule
    {
        public string Name { get; set; } = "";
        public bool IsInstalled { get; set; }
        public string Version { get; set; } = "";
    }

    private List<Student> Students;
    private List<TextRecord> TextRecords;
    private List<Theme> Themes;
    
    private Timer _timer;
    private string BeamStatus = "Inconnu";
    private string PythonInstallStatus = "";
    private string PythonInstallOutput = "";
    private List<PythonModule> pythonModules = new();
    private bool isCheckingModules = false;
    private bool hasCheckedModules = false;
    private int selectedTextMenu = 1;
    private int selectedStudentMenu = 1;
    private int selectedThemeMenu = 1;
    private string newTextTitle;
    private string newTextContent;
    private Student newStudentModel = new Student();
    
    private int selectedInputMode = 1;
    private byte[]? uploadedImageBytes = null;
    
    private string imageBase64 = "";
    private List<ResultatOCR> resultats = new();
    
    // Variables pour les thèmes
    private string newThemeName = "";
    private byte[][] themeImages = new byte[5][];
    
    bool ContainsId(string id)
    {
        return CalibrationService._queue.Any(item => item.Item1 == id);
    }
    
    bool IsReadingProcessing(string readingId)
    {
        // Vérifier si le readingId correspond à celui en cours de traitement
        // Le clientId actuel est stocké dans CalibrationService.clientId
        // et la queue contient les paires (clientId, textRecordFilePath)
        
        // On cherche dans la base de données si ce reading existe et correspond au client en cours
        var reading = Db.Readings.FirstOrDefault(r => r.Id == readingId);
        if (reading == null) return false;
        
        // Vérifier si ce reading est en cours de traitement
        return CalibrationService.clientId == reading.StudentId ||
               CalibrationService._queue.Any(item => item.Item1 == reading.StudentId);
    }
    
private async Task GenererImage()
{
    try
    {
        int largeur = 1920;
        int hauteur = 1080;

        using var bitmap = new SKBitmap(largeur, hauteur);
        using var canvas = new SKCanvas(bitmap);
        canvas.Clear(SKColors.White);

        var paint = new SKPaint
        {
            Color = SKColors.Black,
            TextSize = 64,
            IsAntialias = true
        };

        float margin = 50;
        float topMargin = 100;
        float bottomMargin = 30; // ✅ marge basse réduite
        float maxWidth = largeur - (2 * margin);

        // ================================
        // 1) Découpage du texte en lignes
        // ================================
        var words = newTextContent.Split(' ');
        var lines = new List<string>();
        string currentLine = "";

        foreach (var word in words)
        {
            var testLine = string.IsNullOrEmpty(currentLine)
                ? word
                : currentLine + " " + word;

            if (paint.MeasureText(testLine) <= maxWidth)
            {
                currentLine = testLine;
            }
            else
            {
                lines.Add(currentLine);
                currentLine = word;
            }
        }

        if (!string.IsNullOrEmpty(currentLine))
            lines.Add(currentLine);

        // ================================
        // 2) Calcul de l'espacement vertical
        // ================================
        float availableHeight = hauteur - topMargin - bottomMargin;
        float lineHeight = availableHeight / lines.Count;

        // Point de départ précis (baseline)
        float y = topMargin + paint.TextSize;

        // ================================
        // 3) Dessin du texte
        // ================================
        foreach (var line in lines)
        {
            canvas.DrawText(line, margin, y, paint);
            y += lineHeight;
        }

        // ================================
        // 4) Encodage de l'image
        // ================================
        using var image = SKImage.FromBitmap(bitmap);
        using var data = image.Encode(SKEncodedImageFormat.Png, 100);

        var bytes = data.ToArray();
        imageBase64 = Convert.ToBase64String(bytes);

        await AnalyserImage(bytes);
    }
    catch (Exception ex)
    {
        Console.WriteLine("Erreur génération image : " + ex.Message);
    }

    await InvokeAsync(StateHasChanged);
}
    private async Task AnalyserImage(byte[] imageBytes)
    {
        try
        {
            string tessDataPath = @"C:\Program Files\Tesseract-OCR\tessdata";
            resultats.Clear();

            // Caractères spéciaux à retirer (SANS apostrophes et tirets)
            var symbols = new HashSet<string> { "?", "!", ".", ",", ";", ":", "\"", "«", "»", "(", ")", "[", "]", "{", "}", "_", "—", "…", "/", "\\", "|" };

            using var engine = new TesseractEngine(tessDataPath, "fra", EngineMode.Default);
            using var pix = Pix.LoadFromMemory(imageBytes);
            using var page = engine.Process(pix);
            using var iter = page.GetIterator();

            iter.Begin();
            int lineNum = 0;
            float prevRight = 0;
            float espace = 0;

            do
            {
                if (iter.IsAtBeginningOf(PageIteratorLevel.TextLine))
                {
                    lineNum++;
                    prevRight = 0;
                }

                if (iter.TryGetBoundingBox(PageIteratorLevel.Word, out var rect))
                {
                    string mot = iter.GetText(PageIteratorLevel.Word)?.Trim() ?? "";
                    float conf = iter.GetConfidence(PageIteratorLevel.Word) * 100;

                    // Nettoyer le mot en retirant tous les caractères spéciaux
                    string motNettoye = new string(mot.Where(c => !symbols.Contains(c.ToString())).ToArray());
                    
                    // Ignorer si le mot est vide après nettoyage ou ne contient que des symboles
                    if (string.IsNullOrWhiteSpace(motNettoye))
                        continue;

                    if (prevRight > 0)
                    {
                        espace = rect.X1 - prevRight;
                        if (espace < 0) espace = rect.X1 / 2f;
                    }
                    else
                    {
                        espace = 0;
                    }

                    resultats.Add(new ResultatOCR
                    {
                        Mot = motNettoye,
                        X = (int)(rect.X1 - (espace / 2f)),
                        Y = rect.Y1,
                        Largeur = (int)(rect.Width + espace),
                        Hauteur = rect.Height,
                        Ligne = lineNum,
                        Espace = (int)espace,
                        Confiance = (int)conf
                    });

                    prevRight = rect.X2;
                }

            } while (iter.Next(PageIteratorLevel.Word));
            
            // En mode IMAGE, remplir automatiquement newTextContent avec le texte détecté
            if (selectedInputMode == 2 && resultats.Count > 0)
            {
                // Reconstruire le texte à partir des résultats OCR
                var textBuilder = new StringBuilder();
                int currentLine = 0;
                
                foreach (var r in resultats.OrderBy(x => x.Ligne).ThenBy(x => x.X))
                {
                    if (r.Ligne > currentLine)
                    {
                        textBuilder.AppendLine(); // Nouvelle ligne
                        currentLine = r.Ligne;
                    }
                    else if (textBuilder.Length > 0 && !textBuilder.ToString().EndsWith("\n"))
                    {
                        textBuilder.Append(" "); // Espace entre les mots
                    }
                    
                    textBuilder.Append(r.Mot);
                }
                
                newTextContent = textBuilder.ToString().Trim();
                Console.WriteLine($"Texte reconstruit depuis OCR : {newTextContent.Length} caractères");
            }
            
            Console.WriteLine($"OCR terminé : {resultats.Count} mots détectés");
        }
        catch (Exception ex)
        {
            Console.WriteLine("Erreur OCR : " + ex.Message);
        }
    }


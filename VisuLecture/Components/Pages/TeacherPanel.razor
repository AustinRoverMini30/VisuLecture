    private async Task ImportStudentsFromCSV(InputFileChangeEventArgs e)
    {
        try
        {
            var file = e.File;
            if (file == null)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Attention", "Aucun fichier sélectionné.");
                return;
            }

            const long maxSize = 5 * 1024 * 1024; // 5MB
            
            // Lire le contenu du fichier
            using var stream = file.OpenReadStream(maxSize);
            using var reader = new StreamReader(stream, Encoding.UTF8);
            string csvContent = await reader.ReadToEndAsync();
            
            var lines = csvContent.Split(new[] { '\r', '\n' }, StringSplitOptions.RemoveEmptyEntries);
            
            if (lines.Length < 2)
            {
                NotificationService.Notify(NotificationSeverity.Warning, "Attention", "Le fichier CSV est vide ou invalide.");
                return;
            }
            
            int imported = 0;
            int updated = 0;
            int errors = 0;
            
            // Ignorer l'en-tête (ligne 0)
            for (int i = 1; i < lines.Length; i++)
            {
                try
                {
                    var parts = ParseCSVLine(lines[i]);
                    
                    if (parts.Length < 7)
                    {
                        Console.WriteLine($"Ligne {i + 1} ignorée : nombre de colonnes insuffisant ({parts.Length} colonnes)");
                        errors++;
                        continue;
                    }
                    
                    string id = parts[0].Trim();
                    string firstName = parts[1].Trim();
                    string lastName = parts[2].Trim();
                    
                    if (!int.TryParse(parts[3].Trim(), out int age))
                    {
                        Console.WriteLine($"Ligne {i + 1} ignorée : âge invalide '{parts[3]}'");
                        errors++;
                        continue;
                    }
                    
                    if (!int.TryParse(parts[4].Trim(), out int lunette))
                    {
                        Console.WriteLine($"Ligne {i + 1} ignorée : lunette invalide '{parts[4]}'");
                        errors++;
                        continue;
                    }
                    
                    if (!int.TryParse(parts[5].Trim(), out int theme))
                    {
                        Console.WriteLine($"Ligne {i + 1} ignorée : thème invalide '{parts[5]}'");
                        errors++;
                        continue;
                    }
                    
                    string remarque = parts[6].Trim();
                    
                    // Vérifier si l'élève existe déjà (par ID)
                    var existingStudent = Students.FirstOrDefault(s => s.Id == id);
                    
                    if (existingStudent != null)
                    {
                        // Mise à jour
                        existingStudent.FirstName = firstName;
                        existingStudent.LastName = lastName;
                        existingStudent.Age = age;
                        existingStudent.Lunette = lunette;
                        existingStudent.Theme = theme;
                        existingStudent.Remarque = remarque;
                        
                        Db.Students.Update(existingStudent);
                        updated++;
                    }
                    else
                    {
                        // Nouvel élève
                        var newStudent = new Student(id, firstName, lastName, age, lunette, theme, remarque);
                        Students.Add(newStudent);
                        Db.Students.Add(newStudent);
                        imported++;
                    }
                }
                catch (Exception ex)
                {
                    Console.WriteLine($"Erreur ligne {i + 1} : {ex.Message}");
                    errors++;
                }
            }
            
            // Sauvegarder dans la base de données
            await Db.SaveChangesAsync();
            
            string message = $"{imported} élève(s) importé(s), {updated} mis à jour";
            if (errors > 0) message += $", {errors} erreur(s)";
            
            NotificationService.Notify(
                errors > 0 ? NotificationSeverity.Warning : NotificationSeverity.Success, 
                "Import terminé", 
                message
            );
            
            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de l'import : {ex.Message}");
            NotificationService.Notify(NotificationSeverity.Error, "Erreur d'import", 
                $"Impossible d'importer les élèves : {ex.Message}");
        }
    }

    private string EscapeCSV(string value)
    {
        if (string.IsNullOrEmpty(value)) return "";
        
        // Si la valeur contient une virgule, un guillemet ou un retour à la ligne, l'entourer de guillemets
        if (value.Contains(",") || value.Contains("\"") || value.Contains("\n") || value.Contains("\r"))
        {
            // Doubler les guillemets
            value = value.Replace("\"", "\"\"");
            return $"\"{value}\"";
        }
        
        return value;
    }

    private string[] ParseCSVLine(string line)
    {
        var result = new List<string>();
        bool inQuotes = false;
        var currentField = new StringBuilder();
        
        for (int i = 0; i < line.Length; i++)
        {
            char c = line[i];
            
            if (c == '"')
            {
                if (inQuotes && i + 1 < line.Length && line[i + 1] == '"')
                {
                    // Double guillemet = guillemet échappé
                    currentField.Append('"');
                    i++; // Sauter le prochain guillemet
                }
                else
                {
                    // Basculer l'état des guillemets
                    inQuotes = !inQuotes;
                }
            }
            else if (c == ',' && !inQuotes)
            {
                // Séparateur de champ
                result.Add(currentField.ToString());
                currentField.Clear();
            }
            else
            {
                currentField.Append(c);
            }
        }
        
        // Ajouter le dernier champ
        result.Add(currentField.ToString());
        
        return result.ToArray();
    }


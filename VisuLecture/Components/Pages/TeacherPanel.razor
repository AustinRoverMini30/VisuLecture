    private async Task OnThemeImageSelected(InputFileChangeEventArgs e, int index)
    {
        try
        {
            var file = e.File;
            if (file == null) return;

            const long maxSize = 5 * 1024 * 1024; // 5MB

            using var ms = new MemoryStream();
            await file.OpenReadStream(maxSize).CopyToAsync(ms);

        };
    }
    
    private string GetThemeImagePath()
    {
        string themeName = GetThemeName();
        
        if (themeName == "défaut")
        {
            return ""; // Ne devrait pas arriver, mais par sécurité
        }
        
        // Sélectionner une image aléatoire ou en fonction de la position actuelle
        // Pour simplifier, on utilise la position actuelle pour varier les images
        int imageIndex = currentPosition % 5; // On suppose qu'il y a 5 images (0-4)
        
        if (themeName == "planets")
        {
            // Les images planet.png, planet1.png, planet2.png, planet3.png, planet4.png
            if (imageIndex == 0)
                return $"/pictures/themes/{themeName}/planet.png";
            else
                return $"/pictures/themes/{themeName}/planet{imageIndex}.png";
        }
        
        return ""; // Fallback
    }


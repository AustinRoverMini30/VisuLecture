@code {
    Student model = new Student();
    TextRecord textRecord = new TextRecord("", "", "", "");
    string studentId;
    string textRecordId;
    private int selectedStudentMenu = 1;

    private List<Student> Students;
    private List<TextRecord> TextRecords;
    
    // Variables pour la gestion des caméras
    private List<CameraDevice> availableCameras = new List<CameraDevice>();
    private string selectedCameraId = "";
    private string selectedCameraLabel = "";
    private bool isCameraTesting = false;

    private bool isCalibratingServer = false;
    private bool wasCalibrated = false;
    private static int dotW = 50;
    private bool isCalibrating = false;
    private string serverStat = "";
    private string FacingMode = "user"; // "environment" pour caméra arrière
    private string? Info;
    private bool _cameraStarted = false;
    private bool _isRecording = false;
    private int screenW = 1920;
    private int screenH = 1080;
    private int dotX = 960; // Centre de l'écran (1920/2)
    private int dotY = 540; // Centre de l'écran (1080/2)
    private int currentPosition = 0;
    private int indexCalibration = 0;
    private List<(int x, int y)> positions = new List<(int, int)>();
    private List<long> recordedClick = new List<long>();
    private readonly Stopwatch sw = new();

    private CancellationTokenSource cts;
    private List<PointGaze> gazePoints = new();
    private string readingId; // ID de l'enregistrement de lecture
    private bool isReading = false;
    private bool isProcessing = false;
    private int stepSelected = 0;
    private bool upButtonStat = false;
    private bool downButtonStat = false;

    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        Students = new List<Student>(Db.Students.AsEnumerable());
        TextRecords = new List<TextRecord>(Db.TextRecords.AsEnumerable());
        
        // Nettoyer les enregistrements orphelins
        CleanOrphanRecords();
    }
    
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var size = await JS.InvokeAsync<WindowSize>("getWindowSize");
            screenW = size.width;
            screenH = size.height;

            // Définir les positions : centre, puis coins dans le sens horaire
            positions.Add((screenW / 2, screenH / 2)); // 0: Centre
            positions.Add((dotW, dotW)); // 1: Coin supérieur gauche
            positions.Add((screenW - dotW, dotW)); // 2: Coin supérieur droit
            positions.Add((screenW - dotW, screenH - dotW)); // 3: Coin inférieur droit
            positions.Add((dotW, screenH - dotW)); // 4: Coin inférieur gauche

            // Charger les caméras disponibles
            await LoadAvailableCameras();

            StateHasChanged();
        }
    }

    private void CleanOrphanRecords()
    {
        try
        {
            // Récupérer tous les IDs de lecture existants dans la DB
            var existingReadingIds = Db.Readings.Select(r => r.Id).ToHashSet();
            
            // Nettoyer le dossier records
            CleanOrphanDirectory("records", existingReadingIds);
            
            // Nettoyer le dossier uploads
            CleanOrphanDirectory("uploads", existingReadingIds);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du nettoyage des enregistrements orphelins: {ex.Message}");
        }
    }
    
    private void CleanOrphanDirectory(string directoryName, HashSet<string> existingReadingIds)
    {
        try
        {
            string directoryPath = Path.Combine(Directory.GetCurrentDirectory(), directoryName);
            
            if (!Directory.Exists(directoryPath))
            {
                Console.WriteLine($"Le dossier '{directoryName}' n'existe pas.");
                return;
            }
            
            // Parcourir tous les sous-dossiers
            var subDirectories = Directory.GetDirectories(directoryPath);
            
            foreach (var dir in subDirectories)
            {
                var dirName = Path.GetFileName(dir);
                
                // Si le dossier ne correspond à aucun ID de lecture dans la DB
                if (!existingReadingIds.Contains(dirName))
                {
                    try
                    {
                        Directory.Delete(dir, true); // true pour supprimer récursivement
                        Console.WriteLine($"Dossier orphelin supprimé dans {directoryName}: {dirName}");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Erreur lors de la suppression du dossier {dirName} dans {directoryName}: {ex.Message}");
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du nettoyage du dossier {directoryName}: {ex.Message}");
        }
    }

    void OnSubmit(Student model)
    {
        OnChange();
        
        // Vérifier si l'élève existe déjà dans la base de données
        var existingStudent = Db.Students.FirstOrDefault(s => s.Id == model.Id);
        
        if (existingStudent != null)
        {
            // Mise à jour de l'élève existant
            existingStudent.UpdateFrom(model);
            Db.Students.Update(existingStudent);
        }
        else
        {
            // Création d'un nouvel élève
            Db.Students.Add(model);
        }
        
        Db.SaveChanges();

        // Rafraîchir la liste des élèves
        Students = new List<Student>(Db.Students.AsEnumerable());

        studentId = model.Id;
    }

    void OnInvalidSubmit(FormInvalidSubmitEventArgs args)
    {
    }

    void OnChange()
    {
        if (stepSelected == 0)
        {
            downButtonStat = false;
            // Le bouton suivant est activé dès qu'une caméra est sélectionnée
        }
        else if (stepSelected == 1)
        {
            downButtonStat = true;

            upButtonStat = model.FirstName != "";
        }
        else if (stepSelected == 2)
        {
            downButtonStat = true;

            upButtonStat = textRecord.Name != "";
        }
        else if (stepSelected == 3)
        {
            EnterFullScreen();
            upButtonStat = wasCalibrated;

            downButtonStat = !wasCalibrated;
        }
        else if (stepSelected == 4)
        {
            EnterFullScreen();
            upButtonStat = false;
            downButtonStat = false;
        }
    }

    void SelectStudent(Student args)
    {
        studentId = args.Id;
        model = args;
        OnChange();
    }
    
    void ModifyStudent(Student args)
    {
        // Sélectionner l'élève et basculer vers l'onglet INSCRIRE pour permettre la modification
        studentId = args.Id;
        model = args;
        selectedStudentMenu = 1; // Basculer vers l'onglet INSCRIRE
        StateHasChanged();
    }

    void SelectText(TextRecord args)
    {
        textRecordId = args.Id;
        textRecord = args;
        
        // Créer un nouvel enregistrement de lecture
        var reading = new Reading(studentId, args.Id);
        Db.Readings.Add(reading);
        Db.SaveChanges();
        
        // Stocker l'ID de la lecture pour l'utiliser dans le processus de calibration
        readingId = reading.Id;
        
        OnChange();
    }

    public class WindowSize
    {
        public int width { get; set; }
        public int height { get; set; }
    }


    private async Task CalibrateServer()
    {
        isCalibratingServer = false;
        wasCalibrated = true;

        // Passer automatiquement à l'onglet lecture (étape 4)
        stepSelected = 4;

        OnChange();
    }

    private async Task StartCalibration()
    {
        downButtonStat = true;

        // Masquer la scrollbar
        await JSRuntime.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden';");

        // Utiliser l'ID de la lecture créée lors de la sélection du texte
        await StartRecording(indexCalibration, readingId);

        currentPosition = 0;
        dotX = positions[0].x;
        dotY = positions[0].y;
        isCalibrating = true;
    }

    private async Task OnDotClick()
    {
        if (!isCalibrating) return;

        indexCalibration++;

        await SwitchRecording();

        currentPosition++;
        if (currentPosition < positions.Count)
        {
            dotX = positions[currentPosition].x;
            dotY = positions[currentPosition].y;
        }
        else
        {
            isCalibrating = false;
            
            // Rétablir la scrollbar
            await JSRuntime.InvokeVoidAsync("eval", "document.body.style.overflow = '';");

            currentPosition = 0;

            isCalibratingServer = true;

            serverStat = "Envoi des vidéos au serveur en cours...";
            await InvokeAsync(StateHasChanged);

            await StopRecording();
            await UploadVideo(readingId);

            serverStat = "Calibration côté serveur en cours...";
            await InvokeAsync(StateHasChanged);

            indexCalibration = 0;
            await CalibrationService.NotifyCalibrationCreation(readingId);
            await CalibrateServer();
        }
    }

    private async Task EnterFullScreen()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                const elem = document.documentElement;
                if (elem.requestFullscreen) {
                    elem.requestFullscreen();
                } else if (elem.webkitRequestFullscreen) {
                    elem.webkitRequestFullscreen();
                } else if (elem.msRequestFullscreen) {
                    elem.msRequestFullscreen();
                }
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur plein écran: {ex.Message}");
        }
    }

    private async Task ExitFullScreen()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("eval", @"
                if (document.fullscreenElement || document.webkitFullscreenElement || document.msFullscreenElement) {
                    if (document.exitFullscreen) {
                        document.exitFullscreen();
                    } else if (document.webkitExitFullscreen) {
                        document.webkitExitFullscreen();
                    } else if (document.msExitFullscreen) {
                        document.msExitFullscreen();
                    }
                }
            ");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur sortie plein écran: {ex.Message}");
        }
    }


    private async Task StartCalibration()
    {
        downButtonStat = true;

        // Masquer la scrollbar
        await JSRuntime.InvokeVoidAsync("eval", "document.body.style.overflow = 'hidden';");

        // Démarrer l'enregistrement avec limite de durée (en secondes)
        await JS.InvokeVoidAsync("startRecordingWithDuration", 0, readingId, CalibrationDurationSeconds, 
            DotNetObjectReference.Create(this));

        currentPosition = 0;
        dotX = positions[0].x;
        dotY = positions[0].y;
        isCalibrating = true;
        
        // Réinitialiser le timer (utilisé uniquement pour l'affichage visuel)
        calibrationElapsedMs = 0;
        calibrationProgress = calibrationCircumference;
        
        // Démarrer le timer automatique pour l'animation visuelle
        StartCalibrationTimer();
    }

    private void StartCalibrationTimer()
    {
        calibrationTimer?.Dispose();
        calibrationTimer = new Timer(_ => 
        {
            _ = InvokeAsync(async () => await OnCalibrationTick());
        }, null, 0, 100); // Tick toutes les 100ms
    }

    private async Task OnCalibrationTick()
    {
        if (!isCalibrating) return;

        calibrationElapsedMs += 100;
        
        // Mettre à jour la progression du cercle (de circonférence complète vers 0)
        // Utiliser CalibrationDurationSeconds pour la durée
        double estimatedDuration = CalibrationDurationSeconds * 1000.0; // en ms
        double progress = (double)calibrationElapsedMs / estimatedDuration;
        calibrationProgress = calibrationCircumference * (1 - progress);
        
        StateHasChanged();

        // La progression est maintenant gérée par OnDurationReached()
        // Le timer JavaScript arrête automatiquement l'enregistrement après la durée spécifiée
    }

    private async Task MoveToNextCalibrationPoint()
    {
        currentPosition++;
        
        if (currentPosition < CalibrationPointsCount)
        {
            // Passer au point suivant
            dotX = positions[currentPosition].x;
            dotY = positions[currentPosition].y;
            
            // Réinitialiser le timer visuel
            calibrationElapsedMs = 0;
            calibrationProgress = calibrationCircumference;
            
            StateHasChanged();
            
            // Démarrer un nouvel enregistrement pour ce point avec la durée spécifiée
            await JS.InvokeVoidAsync("startNextPointRecordingByDuration", CalibrationDurationSeconds, 
                DotNetObjectReference.Create(this));
        }
        else
        {
            // Calibration terminée
            await EndCalibration();
        }
    }

    private async Task EndCalibration()
    {
        calibrationTimer?.Dispose();
        calibrationTimer = null;

        isCalibrating = false;

        // Rétablir la scrollbar
        await JSRuntime.InvokeVoidAsync("eval", "document.body.style.overflow = '';");

        currentPosition = 0;

        isCalibratingServer = true;

        serverStat = "Envoi des vidéos au serveur en cours...";
        await InvokeAsync(StateHasChanged);

        // Arrêter l'enregistrement de la dernière vidéo
        await JS.InvokeVoidAsync("stopCalibrationRecordingByDuration");
        
        // Uploader toutes les vidéos (9 vidéos: video0.webm à video8.webm)

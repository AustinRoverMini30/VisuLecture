                selectedCameraId = availableCameras[0].DeviceId;
                selectedCameraLabel = availableCameras[0].Label;
                Console.WriteLine($"LoadAvailableCameras: caméra sélectionnée = {selectedCameraLabel}");
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du chargement des caméras: {ex.Message}");
        }
    }

    // Méthode appelée quand l'utilisateur change de caméra
    private async Task OnCameraChange(object value)
    {
        upButtonStat = false;
        selectedCameraId = value?.ToString() ?? "";
        var camera = availableCameras.FirstOrDefault(c => c.DeviceId == selectedCameraId);
        if (camera != null)
        {
            selectedCameraLabel = camera.Label;
        }

        // Si un test était en cours, l'arrêter
        if (isCameraTesting)
        {
            await StopCameraTest();
            isCameraTesting = false;
        }

        OnChange();
    }

    // Méthode pour tester la caméra sélectionnée
    private async Task TestCamera()
    {
        try
        {
            Console.WriteLine($"TestCamera appelé avec deviceId: {selectedCameraId}");
            await JSRuntime.InvokeVoidAsync("testCamera", selectedCameraId);
            Console.WriteLine("TestCamera terminé avec succès");
            upButtonStat = true;
            StateHasChanged();


        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors du test de la caméra: {ex.Message}");
        }
    }

    // Méthode appelée quand on clique sur le bouton TESTER
    private async Task TestCameraButton()
    {
        isCameraTesting = true;
        StateHasChanged();

        await Task.Delay(100); // Petit délai pour que l'UI se mette à jour
        await TestCamera();
    }

    // Méthode pour arrêter le test de la caméra
    private async Task StopCameraTest()
    {
        try
        {
            await JSRuntime.InvokeVoidAsync("stopCameraTest");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de l'arrêt du test de la caméra: {ex.Message}");
        }
    }

    // Méthodes pour gérer les thèmes
    private List<dynamic> GetThemeOptions()
    {
        var options = new List<dynamic>
        {
            new { Text = "Défaut (ronds blancs)", Value = 0 }
        };
        
        // Ajouter les thèmes depuis la base de données
        var themes = Db.Themes.OrderBy(t => t.Id).ToList();
        foreach (var theme in themes)
        {
            options.Add(new { Text = theme.Name, Value = theme.Id });
        }
        
        return options;
    }

    private string GetThemeName()
    {
        if (model.Theme == 0) return "défaut";
        
        var theme = Db.Themes.FirstOrDefault(t => t.Id == model.Theme);
        return theme?.FolderName ?? "défaut";
    }

    private string GetThemeImagePath()
    {
        string themeName = GetThemeName();

        if (themeName == "défaut")
        {
            return ""; // Ne devrait pas arriver, mais par sécurité
        }

        // Sélectionner une image en fonction de la position actuelle
        // Les images sont numérotées de 1 à 9
        int imageIndex = (currentPosition % 9) + 1;

        return $"/pictures/themes/{themeName}/{imageIndex}.png";
    }


}
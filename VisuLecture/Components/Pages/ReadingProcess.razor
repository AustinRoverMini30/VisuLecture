    protected override void OnInitialized()
    {
        base.OnInitialized();

        Students = new List<Student>(Db.Students.AsEnumerable());
        TextRecords = new List<TextRecord>(Db.TextRecords.AsEnumerable());

        // Nettoyer les enregistrements orphelins
        CleanOrphanRecords();

        // Enregistrer que la calibration est en attente
        await CalibrationService.NotifyCalibrationCreation(readingId);
        
        serverStat = "Calibration enregistrée !";
        await InvokeAsync(StateHasChanged);
        
        await Task.Delay(500); // Petit délai pour voir le message
        
        await CalibrateServer();
    }


    private async Task OnStepDown()
    {
        if (stepSelected > 0)
        {
            stepSelected--;
            
            // Si on revient à l'étape caméra, arrêter le test en cours
            if (stepSelected == 0 && isCameraTesting)
            {
                await StopCameraTest();
                isCameraTesting = false;
            }
        }

        OnChange();
    }

    private async Task OnStepUp()
    {
        // Si on quitte l'étape caméra (étape 0), arrêter le test et sauvegarder la sélection
        if (stepSelected == 0)
        {
            await StopCameraTest();
            await JSRuntime.InvokeVoidAsync("setSelectedCamera", selectedCameraId);
        }
        
        if (stepSelected < 4)
        {
            stepSelected++;
        }

        OnChange();

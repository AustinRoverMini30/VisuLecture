@inject DialogService DialogService
@using VisuLecture.Components.Controller
@using VisuLecture.Components.Model
@using Theme = VisuLecture.Components.Model.Theme
@rendermode InteractiveServer
@inject AppDbContext Db

<div class="student-modifier-container">
    <div class="modifier-header">
        <RadzenIcon Icon="edit" style="font-size: 2rem; color: #667eea; margin-right: 0.5rem;" />
        <h3 class="modifier-title">Modifier l'élève</h3>
    </div>
    
    <div class="modifier-subtitle">
        <RadzenText TextStyle="TextStyle.Body1" style="color: #666;">
            @editedStudent.FirstName @editedStudent.LastName
        </RadzenText>
    </div>

    <RadzenTemplateForm TItem="Student" Data=@editedStudent Submit=@OnSubmit>
        <RadzenStack Gap="1.2rem" class="rz-p-sm-12">

            <!-- First Name -->
            <RadzenFormField Text="Prénom" Variant="@variant">
                <ChildContent>
                    <RadzenTextBox Name="FirstName" @bind-Value=@editedStudent.FirstName class="form-input"/>
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="FirstName" Text="Le prénom est requis."/>
                </Helper>
            </RadzenFormField>

            <!-- Last Name -->
            <RadzenFormField Text="Nom" Variant="@variant">
                <ChildContent>
                    <RadzenTextBox Name="LastName" @bind-Value=@editedStudent.LastName class="form-input"/>
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="LastName" Text="Le nom est requis."/>
                </Helper>
            </RadzenFormField>

            <!-- Age -->
            <RadzenFormField Text="Âge" Variant="@variant">
                <ChildContent>
                    <RadzenNumeric Name="Age" @bind-Value=@editedStudent.Age Min="0" Max="15" class="form-input"/>
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Age" Text="L'âge est requis."/>
                </Helper>
            </RadzenFormField>

            <!-- Lunette -->
            <RadzenFormField Text="Porte des lunettes" Variant="@variant">
                <ChildContent>
                    <RadzenRadioButtonList Name="Lunette" @bind-Value=@editedStudent.Lunette TValue="int">
                        <Items>
                            <RadzenRadioButtonListItem Text="Non" Value="1"/>
                            <RadzenRadioButtonListItem Text="Oui" Value="2"/>
                        </Items>
                    </RadzenRadioButtonList>
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Lunette" Text="Champ obligatoire."/>
                </Helper>
            </RadzenFormField>

            <!-- Theme -->
            <RadzenFormField Text="Thème préféré">
                <ChildContent>
                    <RadzenDropDown Name="Theme" 
                                    @bind-Value=@editedStudent.Theme 
                                    Data=@GetThemeOptions()
                                    TextProperty="Text"
                                    ValueProperty="Value"
                                    TValue="int"
                                    class="form-input" />
                </ChildContent>
                <Helper>
                    <RadzenRequiredValidator Component="Theme" Text="Champ obligatoire." />
                </Helper>
            </RadzenFormField>

            <!-- Remarque -->
            <RadzenFormField Text="Remarque" Variant="@variant">
                <ChildContent>
                    <RadzenTextArea Name="Remarque" @bind-Value=@editedStudent.Remarque Rows="3" class="form-textarea"/>
                </ChildContent>
            </RadzenFormField>

            <!-- Submit Buttons -->
            <div class="form-actions">
                <RadzenButton ButtonType="ButtonType.Submit" 
                            ButtonStyle="ButtonStyle.Success"
                            class="btn-submit">
                    <RadzenIcon Icon="check" style="margin-right: 5px;" /> Enregistrer
                </RadzenButton>
                <RadzenButton ButtonStyle="ButtonStyle.Light" 
                            Click="@(() => DialogService.Close(null))"
                            class="btn-cancel">
                    <RadzenIcon Icon="close" style="margin-right: 5px;" /> Annuler
                </RadzenButton>
            </div>
        </RadzenStack>
    </RadzenTemplateForm>
</div>

<style>
    .student-modifier-container {
        padding: 1rem;
        max-width: 600px;
    }
    
    .modifier-header {
        display: flex;
        align-items: center;
        margin-bottom: 0.5rem;
    }
    
    .modifier-title {
        font-family: 'Eurostile', sans-serif;
        font-size: 1.5rem;
        color: #333;
        margin: 0;
    }
    
    .modifier-subtitle {
        margin-bottom: 1.5rem;
        padding-left: 2.5rem;
    }
    
    .form-input, .form-textarea {
        width: 100%;
    }
    
    .form-actions {
        display: flex;
        gap: 1rem;
        margin-top: 1rem;
        justify-content: flex-end;
    }
    
    .btn-submit {
        padding: 0.8rem 1.5rem;
    }
    
    .btn-cancel {
        padding: 0.8rem 1.5rem;
    }
</style>


@code {
    
    [Parameter] public Student Student { get; set; }
    private Student editedStudent;
    
    Variant variant = Variant.Outlined;
    
    private List<Theme> Themes;
    
    protected override void OnInitialized()
    {
        base.OnInitialized();
        
        Themes = new List<Theme>(Db.Themes.AsEnumerable());

        editedStudent = new Student(Student.Id, Student.FirstName, Student.LastName, Student.Age, Student.Lunette, Student.Theme, Student.Remarque);
    }

    void OnSubmit(Student stu)
    {
        Student.UpdateFrom(stu);
        DialogService.Close(stu);
    }
    
    private List<dynamic> GetThemeOptions()
    {
        var options = new List<dynamic>
        {
            new { Text = "Défaut (ronds blancs)", Value = 0 }
        };
        
        // Ajouter les thèmes depuis la base de données
        foreach (var theme in Themes.OrderBy(t => t.Id))
        {
            options.Add(new { Text = theme.Name, Value = theme.Id });
        }
        
        return options;
    }
}
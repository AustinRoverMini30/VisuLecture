@using VisuLecture.Components.Model
@inject DialogService DialogService

<div class="error-logs-container">
    @if (!ErrorLogs.Any())
    {
        <div class="no-errors-message">
            <RadzenIcon Icon="check_circle" style="font-size: 48px; color: #4caf50; margin-bottom: 1rem;" />
            <h3>Aucune erreur enregistrée</h3>
            <p>Il n'y a actuellement aucune erreur de calibration dans les logs.</p>
        </div>
    }
    else
    {
        <div class="logs-header">
            <p>Total : <strong>@ErrorLogs.Count</strong> erreur(s) enregistrée(s)</p>
            <RadzenButton Text="Effacer tous les logs" 
                        Icon="delete" 
                        ButtonStyle="ButtonStyle.Danger" 
                        Size="ButtonSize.Small"
                        Click="@ClearAllLogs" />
        </div>
        
        <div class="logs-list">
            @foreach (var log in ErrorLogs.OrderByDescending(l => l.Timestamp))
            {
                <div class="log-entry">
                    <div class="log-header">
                        <div class="log-timestamp">
                            <RadzenIcon Icon="access_time" style="margin-right: 5px;" />
                            @log.Timestamp.ToString("dd/MM/yyyy HH:mm:ss")
                        </div>
                        <div class="log-client-id">
                            <RadzenIcon Icon="fingerprint" style="margin-right: 5px;" />
                            ID: @log.ClientId
                        </div>
                    </div>
                    <div class="log-message">
                        @log.ErrorMessage
                    </div>
                    @if (!string.IsNullOrEmpty(log.StackTrace))
                    {
                        <details class="log-details">
                            <summary>Détails techniques</summary>
                            <pre class="stack-trace">@log.StackTrace</pre>
                        </details>
                    }
                </div>
            }
        </div>
    }
</div>

<div class="dialog-footer">
    <RadzenButton Text="Fermer" Click="@(() => DialogService.Close())" ButtonStyle="ButtonStyle.Primary" />
</div>

<style>
    .error-logs-container {
        padding: 1rem;
        max-height: calc(70vh - 100px);
        overflow-y: auto;
    }
    
    .no-errors-message {
        text-align: center;
        padding: 3rem;
        color: #666;
    }
    
    .logs-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 2px solid #e0e0e0;
    }
    
    .logs-list {
        display: flex;
        flex-direction: column;
        gap: 1rem;
    }
    
    .log-entry {
        background: #f5f5f5;
        border-left: 4px solid #f44336;
        padding: 1rem;
        border-radius: 4px;
    }
    
    .log-header {
        display: flex;
        justify-content: space-between;
        margin-bottom: 0.5rem;
        font-size: 0.9rem;
        color: #666;
    }
    
    .log-timestamp, .log-client-id {
        display: flex;
        align-items: center;
    }
    
    .log-message {
        color: #d32f2f;
        font-weight: 500;
        margin-bottom: 0.5rem;
    }
    
    .log-details {
        margin-top: 0.5rem;
    }
    
    .log-details summary {
        cursor: pointer;
        color: #1976d2;
        font-size: 0.9rem;
        margin-bottom: 0.5rem;
    }
    
    .stack-trace {
        background: #263238;
        color: #aed581;
        padding: 1rem;
        border-radius: 4px;
        overflow-x: auto;
        font-size: 0.85rem;
        margin: 0;
    }
    
    .dialog-footer {
        margin-top: 1.5rem;
        padding-top: 1rem;
        border-top: 1px solid #e0e0e0;
        text-align: right;
    }
</style>

@code {
    [Parameter]
    public List<CalibrationErrorLog> ErrorLogs { get; set; } = new();
    
    [Inject]
    private CalibrationService CalibrationService { get; set; } = null!;
    
    [Inject]
    private NotificationService NotificationService { get; set; } = null!;
    
    private async Task ClearAllLogs()
    {
        var confirm = await DialogService.Confirm(
            "Êtes-vous sûr de vouloir effacer tous les logs d'erreurs ?",
            "Confirmer la suppression",
            new ConfirmOptions { OkButtonText = "Oui", CancelButtonText = "Non" }
        );

        if (confirm == true)
        {
            CalibrationService.ClearCalibrationErrorLogs();
            ErrorLogs.Clear();
            NotificationService.Notify(NotificationSeverity.Success, "Succès", "Tous les logs ont été effacés.");
            StateHasChanged();
        }
    }
}


@page "/show-data/{readingId}"
@rendermode InteractiveServer
@using System.Globalization
@using VisuLecture.Components.Controller
@using VisuLecture.Components.Model
@using Microsoft.EntityFrameworkCore
@using CsvHelper
@using CsvHelper.Configuration
@inject NotificationService NotificationService
@inject DialogService DialogService
@inject IJSRuntime JS
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<div class="data-viewer-container">
    
    <!-- Hero Section -->
    <section class="data-hero">
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <h1 class="page-title">
                <RadzenIcon Icon="visibility" style="margin-right: 15px; font-size: inherit;" />
                Analyse du parcours visuel
            </h1>
            @if (showedStudent != null && textRecord != null)
            {
                <p class="page-subtitle">
                    <strong>@showedStudent.FirstName @showedStudent.LastName</strong> - @textRecord.Name
                </p>
            }
        </div>
    </section>

    <!-- Controls Section -->
    <section class="controls-section">
        <div class="section-container">
            <!-- Statistiques Section -->
            @if (resultats != null)
            {
                <div class="stats-card">
                    <div class="stats-header">
                        <RadzenIcon Icon="analytics" style="margin-right: 10px; font-size: 1.5rem;" />
                        <h3 class="stats-title">Statistiques de lecture</h3>
                    </div>
                    <div class="stats-content">
                        <div class="stat-item">
                            <div class="stat-label">Total mots</div>
                            <div class="stat-value">@totalMots</div>
                        </div>
                        <div class="stat-item stat-clickable" @onclick="() => ShowMotsLusModal()">
                            <div class="stat-label">Mots lus</div>
                            <div class="stat-value stat-success">@motsLus</div>
                            <div class="stat-hint">Cliquez pour voir la liste</div>
                        </div>
                        <div class="stat-item stat-clickable" @onclick="() => ShowMotsNonLusModal()">
                            <div class="stat-label">Mots non lus</div>
                            <div class="stat-value stat-warning">@motsNonLus</div>
                            <div class="stat-hint">Cliquez pour voir la liste</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Pourcentage lu</div>
                            <div class="stat-value">@pourcentageLu.ToString("0.00")%</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Moyenne fixations / mot</div>
                            <div class="stat-value">@moyenneFixations.ToString("0.00")</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Durée moyenne fixation</div>
                            <div class="stat-value">@moyenneDureeFixation.ToString("0.000") s</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Vitesse de lecture</div>
                            <div class="stat-value stat-primary">@vitesseLecture mots/min</div>
                        </div>
                    </div>
                </div>
            }
            
            <div class="controls-card">
                <div class="controls-header">
                    <RadzenIcon Icon="tune" style="margin-right: 10px; font-size: 1.5rem;" />
                    <h3 class="controls-title">Contrôles de visualisation</h3>
                </div>
                
                <div class="controls-content">
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isCleanedVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données nettoyées" class="control-label red-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isRawVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données brutes" class="control-label green-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isNormalizedVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données normalisées" class="control-label blue-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isSmoothedVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données lissées" class="control-label teal-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isDensityVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Ronds de densité" class="control-label purple-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isWordBoxVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Boîtes autour des mots" class="control-label cyan-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isThickenLinesEnabled Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Épaissir les traits (selon espacement)" class="control-label orange-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isSaccadesVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Afficher les saccades" class="control-label magenta-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@hideJumps Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Cacher les sauts" class="control-label brown-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenButton Click="@GoBack" class="btn-back">
                            <RadzenIcon Icon="arrow_back" style="margin-right: 5px;" />
                            Retour
                        </RadzenButton>
                    </div>
                </div>
            </div>
            
            <!-- Filtre par lignes -->
            @if (totalLines > 0)
            {
                <div class="controls-card">
                    <div class="controls-header">
                        <RadzenIcon Icon="format_line_spacing" style="margin-right: 10px; font-size: 1.5rem;" />
                        <h3 class="controls-title">Filtrer par lignes</h3>
                    </div>
                    
                    <div class="controls-content">
                        <div class="line-filter-info">
                            <RadzenIcon Icon="info" style="margin-right: 5px; color: #667eea;" />
                            <span>Les lignes correspondent aux portions de courbes délimitées par les sauts</span>
                        </div>
                        
                        <div class="line-filter-controls">
                            <RadzenCheckBox @bind-Value=@filterByLines Change="@UpdateOverlay" TValue="bool" />
                            <RadzenLabel Text="Activer le filtre par lignes" class="control-label" />
                        </div>
                        
                        @if (filterByLines)
                        {
                            <div class="line-selection-container">
                                <div class="line-selection-header">
                                    <span class="line-selection-label">Lignes à afficher :</span>
                                    <div class="line-selection-actions">
                                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" 
                                                    Click="@SelectAllLines" class="btn-line-action">
                                            <RadzenIcon Icon="select_all" style="font-size: 0.9rem;" />
                                            Tout sélectionner
                                        </RadzenButton>
                                        <RadzenButton Size="ButtonSize.Small" ButtonStyle="ButtonStyle.Light" 
                                                    Click="@DeselectAllLines" class="btn-line-action">
                                            <RadzenIcon Icon="clear" style="font-size: 0.9rem;" />
                                            Tout désélectionner
                                        </RadzenButton>
                                    </div>
                                </div>
                                
                                <div class="line-checkboxes">
                                    @for (int i = 1; i <= totalLines; i++)
                                    {
                                        int lineNumber = i; // Capture pour le lambda
                                        <div class="line-checkbox-item">
                                            <RadzenCheckBox Value="@selectedLines.Contains(lineNumber)" 
                                                          TValue="bool"
                                                          Change="@(value => ToggleLine(lineNumber, value))" />
                                            <RadzenLabel Text="@($"Ligne {lineNumber}")" class="line-checkbox-label" />
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </section>

    <!-- Visualization Section -->
    <section class="visualization-section">
        <div class="section-container">
            <div class="image-container">
                @if (textRecord != null)
                {
                    <RadzenImage Path="@(textRecord.FilePath + "/image.png")"
                                 Attributes="@(new Dictionary<string, object>
                                             {
                                                 { "id", "backgroundImage" },
                                                 { "class", "calibration-image" }
                                             })" />
                }
                <canvas id="overlayCanvas"></canvas>
            </div>
        </div>
    </section>
    
</div>

@code {
    // ------------------- CLASSES -------------------
    public record MotCsv(string mot, double? x, double? y, double? largeur, double? hauteur, int ligne, string espace, double? confiance);
    public record PointCsv(double timestamp, double x, double y, double jump, double saccade);

    public class Resultat
    {
        public string mot { get; set; }
        public double x { get; set; }
        public double y { get; set; }
        public double largeur { get; set; }
        public double hauteur { get; set; }
        public int nbMot { get; set; }
        public int retourArriere { get; set; }
        public double tempsFixation { get; set; }
        public int ligne { get; set; }
    }

    // ------------------- VARIABLES -------------------
    private List<(double x, double y)> pointsRaw = new();
    private List<(double x, double y)> pointsCleaned = new();
    private List<(double x, double y)> pointsNormalized = new();
    private List<(double x, double y)> pointsSmoothed = new();
    private List<List<(double x, double y)>> saccadesGroups = new(); // Liste de groupes de saccades
    
    // Listes de sauts par courbe
    private List<List<(double x, double y)>> jumpGroupsRaw = new(); // Sauts pour données brutes (cleaned.csv)
    private List<List<(double x, double y)>> jumpGroupsRawCalibrated = new(); // Sauts pour données calibrées (raw.csv)
    private List<List<(double x, double y)>> jumpGroupsNormalized = new(); // Sauts pour données normalisées
    private List<List<(double x, double y)>> jumpGroupsSmoothed = new(); // Sauts pour données lissées
    
    private bool isRawVisible = false;
    private bool isCleanedVisible = false;
    private bool isNormalizedVisible = false;
    private bool isSmoothedVisible = false;
    private bool isDensityVisible = false;
    private bool isWordBoxVisible = false;
    private bool isThickenLinesEnabled = false;
    private bool isSaccadesVisible = false;
    private bool hideJumps = false;
    private bool _firstRenderComplete = false;
    [Parameter] public string readingId { get; set; }
    
    private Reading reading;
    private Student showedStudent;
    private TextRecord textRecord;
    
    // Variables d'analyse
    private List<Resultat> resultats;
    private int totalMots;
    private int motsLus;
    private int motsNonLus;
    private double pourcentageLu;
    private double moyenneFixations;
    private double moyenneDureeFixation;
    private int vitesseLecture;
    
    // Variables pour le filtre des mots
    private int selectedWordFilter = 1; // 1 = mots lus uniquement, 2 = tous les mots
    
    // Variables pour le filtre par lignes
    private bool filterByLines = false;
    private HashSet<int> selectedLines = new();
    private int totalLines = 0;
    
    private async Task UpdateOverlay()
    {
        await JS.InvokeVoidAsync("clearOverlay");
        
        // Dessiner les ronds de densité EN PREMIER (pour qu'ils soient en arrière-plan)
        if (isDensityVisible && resultats != null && resultats.Count > 0)
        {
            await DrawDensityCircles();
        }
        
        // Dessiner les boîtes autour des mots
        if (isWordBoxVisible && resultats != null && resultats.Count > 0)
        {
            await DrawWordBoxes();
        }
        
        // Dessiner les courbes PAR-DESSUS
        if (isCleanedVisible && pointsCleaned != null && pointsCleaned.Count > 0)
        {
            if (isThickenLinesEnabled)
            {
                await DrawThickenedLine(pointsCleaned, jumpGroupsRaw, "red", "blue", hideJumps);
            }
            else
            {
                await DrawCurveWithJumps(pointsCleaned, jumpGroupsRaw, "red", "blue", hideJumps);
            }
        }
        
        if (isRawVisible && pointsRaw != null && pointsRaw.Count > 0)
        {
            if (isThickenLinesEnabled)
            {
                await DrawThickenedLine(pointsRaw, jumpGroupsRawCalibrated, "green", "yellow", hideJumps);
            }
            else
            {
                await DrawCurveWithJumps(pointsRaw, jumpGroupsRawCalibrated, "green", "yellow", hideJumps);
            }
        }
        
        if (isNormalizedVisible && pointsNormalized != null && pointsNormalized.Count > 0)
        {
            if (isThickenLinesEnabled)
            {
                await DrawThickenedLine(pointsNormalized, jumpGroupsNormalized, "#007bff", "#0056b3", hideJumps);
            }
            else
            {
                await DrawCurveWithJumps(pointsNormalized, jumpGroupsNormalized, "#007bff", "#0056b3", hideJumps);
            }
        }
        
        if (isSmoothedVisible && pointsSmoothed != null && pointsSmoothed.Count > 0)
        {
            if (isThickenLinesEnabled)
            {
                await DrawThickenedLine(pointsSmoothed, jumpGroupsSmoothed, "#20c997", "#17a2b8", hideJumps);
            }
            else
            {
                await DrawCurveWithJumps(pointsSmoothed, jumpGroupsSmoothed, "#20c997", "#17a2b8", hideJumps);
            }
        }
        
        // Dessiner les saccades
        if (isSaccadesVisible && saccadesGroups != null && saccadesGroups.Count > 0)
        {
            await DrawSaccades();
        }
    }

    private async Task DrawDensityCircles()
    {
        foreach (var r in resultats)
        {
            if (r.nbMot > 0)
            {
                // Centre du mot
                double centerX = r.x + r.largeur / 2;
                double centerY = r.y + r.hauteur / 2;
                
                // Rayon basé sur le nombre de points (fixations)
                double baseRadius = 15;
                double radius = baseRadius + (r.nbMot * 2);
                
                // Opacité basée sur le nombre de points (augmentée pour meilleure visibilité)
                double opacity = Math.Min(0.4 + (r.nbMot * 0.06), 0.85);
                
                // Couleur en fonction de l'intensité (du vert au rouge)
                string color = $"rgba(0, 0, 255, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
                
                await JS.InvokeVoidAsync("drawDensityCircle", centerX, centerY, radius, color);
            }
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && !_firstRenderComplete && resultats != null)
        {
            _firstRenderComplete = true;
            // Attendre un peu que l'image soit complètement chargée et le canvas dimensionné
            await Task.Delay(100);
            // Redessiner l'overlay avec le canvas correctement dimensionné
            await UpdateOverlay();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Charger la lecture avec ses relations
        reading = await Db.Readings
            .Include(r => r.Student)
            .Include(r => r.TextRecord)
            .FirstOrDefaultAsync(r => r.Id == readingId);
        
        if (reading == null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail = "Enregistrement introuvable"
            });
            return;
        }
        
        showedStudent = reading.Student;
        textRecord = reading.TextRecord;
        
        var csvPath = "records/" + readingId + "/raw.csv";
        var csvRaw = "records/" + readingId + "/cleaned.csv";

        if (!File.Exists(csvPath))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "CSV manquant",
                Detail = $"Fichier introuvable : {csvPath}"
            });
            return;
        }

        // Charger les données calibrées (raw.csv) avec les sauts
        await LoadPointsAndJumps(csvPath, pointsRaw, jumpGroupsRawCalibrated);
        
        // Charger les données brutes (cleaned.csv) avec les sauts et saccades
        var csv = await File.ReadAllLinesAsync(csvRaw);

        pointsCleaned.Clear();
        saccadesGroups.Clear();
        jumpGroupsRaw.Clear();
        
        List<(double x, double y)> currentSaccadeGroup = null;
        List<(double x, double y)> currentJumpGroup = null;

        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line))
                continue;

            var parts = line.Split(',');
            if (parts.Length < 3)
                continue;

            // timestamp,x,y,jump,saccade -> x = parts[1], y = parts[2], jump = parts[3], saccade = parts[4]
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                pointsCleaned.Add((x, y));
                
                // Vérifier si c'est un saut (colonne 3, index 3)
                bool isJump = false;
                if (parts.Length >= 4 && 
                    double.TryParse(parts[3].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var jump) &&
                    jump > 0)
                {
                    isJump = true;
                }
                
                // Vérifier si c'est une saccade (colonne 4, index 4)
                bool isSaccade = false;
                if (parts.Length >= 5 && 
                    double.TryParse(parts[4].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var saccade) &&
                    saccade > 0)
                {
                    isSaccade = true;
                }
                
                if (isJump)
                {
                    // Si pas de groupe en cours, en créer un nouveau
                    if (currentJumpGroup == null)
                    {
                        currentJumpGroup = new List<(double x, double y)>();
                        jumpGroupsRaw.Add(currentJumpGroup);
                    }
                    currentJumpGroup.Add((x, y));
                }
                else
                {
                    // Fin du groupe de sauts
                    currentJumpGroup = null;
                }
                
                if (isSaccade)
                {
                    // Si pas de groupe en cours, en créer un nouveau
                    if (currentSaccadeGroup == null)
                    {
                        currentSaccadeGroup = new List<(double x, double y)>();
                        saccadesGroups.Add(currentSaccadeGroup);
                    }
                    currentSaccadeGroup.Add((x, y));
                }
                else
                {
                    // Fin du groupe de saccades
                    currentSaccadeGroup = null;
                }
            }
            else
            {
                // Optionnel : log / notify pour les lignes malformées
                Console.WriteLine($"Ligne CSV ignorée (parse failed): {line}");
            }
        }
        
        // Charger les données calibrées (raw.csv) avec les sauts
        var csvRawCalibrated = "records/" + readingId + "/raw.csv";
        if (File.Exists(csvRawCalibrated))
        {
            await LoadPointsAndJumps(csvRawCalibrated, pointsRaw, jumpGroupsRawCalibrated);
        }
        
        // Charger les données normalisées si disponibles
        var csvNormalized = "records/" + readingId + "/normalized.csv";
        if (File.Exists(csvNormalized))
        {
            await LoadPointsAndJumps(csvNormalized, pointsNormalized, jumpGroupsNormalized);
        }
        
        // Charger les données lissées si disponibles
        var csvSmoothed = "records/" + readingId + "/smoothed.csv";
        if (File.Exists(csvSmoothed))
        {
            await LoadPointsAndJumps(csvSmoothed, pointsSmoothed, jumpGroupsSmoothed);
        }
        
        // Effectuer l'analyse des mots
        await AnalyseFichiers();
        
        // Calculer le nombre total de lignes
        CalculateTotalLines();
    }
    
    // ------------------- HELPER POUR CHARGER POINTS ET SAUTS -------------------
    private async Task LoadPointsAndJumps(string csvPath, List<(double x, double y)> pointsList, List<List<(double x, double y)>> jumpGroupsList)
    {
        pointsList.Clear();
        jumpGroupsList.Clear();
        
        var csv = await File.ReadAllLinesAsync(csvPath);
        List<(double x, double y)> currentJumpGroup = null;
        
        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line)) continue;
            
            var parts = line.Split(',');
            if (parts.Length < 3) continue;
            
            // timestamp,x,y,jump,saccade (ou juste timestamp,x,y pour certains fichiers)
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                pointsList.Add((x, y));
                
                // Vérifier si c'est un saut (colonne 3, index 3)
                bool isJump = false;
                if (parts.Length >= 4 && 
                    double.TryParse(parts[3].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var jump) &&
                    jump > 0)
                {
                    isJump = true;
                }
                
                if (isJump)
                {
                    // Si pas de groupe en cours, en créer un nouveau
                    if (currentJumpGroup == null)
                    {
                        currentJumpGroup = new List<(double x, double y)>();
                        jumpGroupsList.Add(currentJumpGroup);
                    }
                    currentJumpGroup.Add((x, y));
                }
                else
                {
                    // Fin du groupe de sauts
                    currentJumpGroup = null;
                }
            }
        }
    }
    
    // ------------------- ANALYSE -------------------
    private async Task AnalyseFichiers()
    {
        if (textRecord == null) return;
        
        string pathMots = Path.Combine(Env.WebRootPath, textRecord.FilePath, "resultats_ocr.csv");
        string pathPoints = Path.Combine(Env.ContentRootPath, "records", readingId, "normalized.csv");

        // Vérifier que les fichiers existent
        if (!File.Exists(pathMots))
        {
            Console.WriteLine($"Fichier OCR introuvable : {pathMots}");
            return;
        }
        
        if (!File.Exists(pathPoints))
        {
            Console.WriteLine($"Fichier points introuvable : {pathPoints}");
            return;
        }

        var config = new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            Delimiter = ",",
            Encoding = System.Text.Encoding.UTF8,
            HeaderValidated = null,
            MissingFieldFound = null
        };

        try
        {
            // --- Lecture fichiers ---
            var motsCsv = ReadCsv<MotCsv>(pathMots, config);
            var pointsCsv = ReadCsv<PointCsv>(pathPoints, config)
                .OrderBy(p => p.timestamp)
                .ToList();

            totalMots = motsCsv.Count;
            resultats = new();

            const double margeX = 15;
            const double margeY = 15;

            // --- Analyse de chaque mot ---
            foreach (var m in motsCsv)
            {
                double x = m.x ?? 0;
                double y = m.y ?? 0;
                double w = m.largeur ?? 10;
                double h = m.hauteur ?? 10;

                double xmin = x - margeX;
                double xmax = x + w + margeX;
                double ymin = y - margeY;
                double ymax = y + h + margeY;

                var pts = pointsCsv
                    .Where(p => p.x >= xmin && p.x <= xmax && p.y >= ymin && p.y <= ymax)
                    .ToList();

                int nb = pts.Count;

                // Retours arrière
                int retours = 0;
                for (int i = 1; i < pts.Count; i++)
                    if (pts[i].x < pts[i - 1].x) retours++;

                // Durée fixation
                double duree =
                    nb > 1 ? pts.Last().timestamp - pts.First().timestamp :
                    nb == 1 ? 0.05 : 0;

                // Résultat
                resultats.Add(new Resultat
                {
                    mot = m.mot,
                    x = x,
                    y = y,
                    largeur = w,
                    hauteur = h,
                    nbMot = nb,
                    retourArriere = retours,
                    tempsFixation = Math.Round(duree, 3),
                    ligne = m.ligne
                });
            }

            // --- Statistiques ---
            motsLus = resultats.Count(r => r.nbMot > 0);
            motsNonLus = totalMots - motsLus;
            pourcentageLu = totalMots > 0 ? 100.0 * motsLus / totalMots : 0;

            var lus = resultats.Where(r => r.nbMot > 0).ToList();

            moyenneFixations = lus.Any() ? lus.Average(r => r.nbMot) : 0;
            moyenneDureeFixation = lus.Any() ? lus.Average(r => r.tempsFixation) : 0;

            double tempsTotal = lus.Sum(r => r.tempsFixation);
            vitesseLecture = tempsTotal > 0 ? (int)(motsLus / (tempsTotal / 60.0)) : 0;
            
            Console.WriteLine($"Analyse terminée : {motsLus}/{totalMots} mots lus");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de l'analyse : {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur d'analyse",
                Detail = $"Impossible d'analyser les fichiers : {ex.Message}"
            });
        }
    }

    private async Task DrawWordBoxes()
    {
        foreach (var r in resultats)
        {
            // Dessiner une boîte pour chaque mot (lu ou non)
            // Couleur différente selon si le mot a été lu ou non
            string borderColor;
            double opacity;
            
            if (r.nbMot > 0)
            {
                // Mot lu - couleur en fonction de l'intensité
                opacity = 0.8;
                if (r.nbMot <= 5)
                    borderColor = $"rgba(0, 200, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Vert
                else if (r.nbMot <= 15)
                    borderColor = $"rgba(255, 165, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Orange
                else
                    borderColor = $"rgba(255, 0, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Rouge
            }
            else
            {
                // Mot non lu - gris semi-transparent
                opacity = 0.5;
                borderColor = $"rgba(150, 150, 150, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
            }
            
            await JS.InvokeVoidAsync("drawWordBox", r.x, r.y, r.largeur, r.hauteur, borderColor);
        }
    }
    
    private async Task DrawSaccades()
    {
        // Dessiner chaque groupe de saccades
        foreach (var group in saccadesGroups)
        {
            if (group.Count > 0)
            {
                // Convertir les points du groupe pour JavaScript
                var jsPoints = group.Select(p => new { x = p.x, y = p.y }).ToList();
                await JS.InvokeVoidAsync("drawSaccadeGroup", jsPoints);
            }
        }
    }
    
    private async Task DrawCurveWithJumps(List<(double x, double y)> pointsList, List<List<(double x, double y)>> jumpGroups, string lineColor, string pointColor, bool hideJumps)
    {
        if (pointsList.Count < 2) return;
        
        // Créer un set des indices de points qui sont des sauts
        var jumpIndices = new HashSet<int>();
        foreach (var group in jumpGroups)
        {
            foreach (var jumpPoint in group)
            {
                // Trouver l'index de ce point dans pointsList
                for (int i = 0; i < pointsList.Count; i++)
                {
                    if (Math.Abs(pointsList[i].x - jumpPoint.x) < 0.01 && 
                        Math.Abs(pointsList[i].y - jumpPoint.y) < 0.01)
                    {
                        jumpIndices.Add(i);
                        break;
                    }
                }
            }
        }
        
        // Appliquer le filtre par lignes si activé
        HashSet<int> lineFilteredIndices = null;
        bool hasLineFilter = filterByLines && selectedLines.Count > 0 && selectedLines.Count < totalLines;
        
        if (hasLineFilter)
        {
            lineFilteredIndices = GetLineIndicesForPoints(pointsList, jumpGroups);
        }
        
        if (!hideJumps && !hasLineFilter)
        {
            // Mode normal sans filtre par lignes : afficher toute la courbe avec les sauts en bleu
            var jsPoints = pointsList.Select(p => new { x = p.x, y = p.y }).ToList();
            await JS.InvokeVoidAsync("drawFollowLine", jsPoints, lineColor, pointColor);
            
            // Dessiner les sauts en bleu par-dessus
            foreach (var group in jumpGroups)
            {
                if (group.Count > 0)
                {
                    var jsJumps = group.Select(p => new { x = p.x, y = p.y }).ToList();
                    await JS.InvokeVoidAsync("drawFollowLine", jsJumps, "blue", "blue");
                }
            }
        }
        else
        {
            // Mode hideJumps OU filtre par lignes actif : afficher les courbes comme segments indépendants
            // Séparer les segments non-jump et filtrés par lignes
            var segments = new List<List<(double x, double y)>>();
            var currentSegment = new List<(double x, double y)>();
            
            for (int i = 0; i < pointsList.Count; i++)
            {
                bool isFiltered = lineFilteredIndices != null && !lineFilteredIndices.Contains(i);
                bool isJump = jumpIndices.Contains(i);
                
                // Point valide si : pas un saut (ou hideJumps pas activé) ET pas filtré par ligne
                bool isValidPoint = !isFiltered && (!hideJumps || !isJump);
                
                if (isValidPoint)
                {
                    currentSegment.Add(pointsList[i]);
                }
                else
                {
                    if (currentSegment.Count > 0)
                    {
                        segments.Add(new List<(double x, double y)>(currentSegment));
                        currentSegment.Clear();
                    }
                }
            }
            
            if (currentSegment.Count > 0)
            {
                segments.Add(currentSegment);
            }
            
            // Dessiner chaque segment indépendamment
            foreach (var segment in segments)
            {
                if (segment.Count > 1)
                {
                    var jsSegment = segment.Select(p => new { x = p.x, y = p.y }).ToList();
                    await JS.InvokeVoidAsync("drawFollowLine", jsSegment, lineColor, pointColor);
                }
            }
        }
    }
    
    private async Task DrawThickenedLine(List<(double x, double y)> pointsList, List<List<(double x, double y)>> jumpGroups, string lineColor, string pointColor, bool hideJumps)
    {
        if (pointsList.Count < 2) return;
        
        // Créer un set des indices de points qui sont des sauts
        var jumpIndices = new HashSet<int>();
        foreach (var group in jumpGroups)
        {
            foreach (var jumpPoint in group)
            {
                // Trouver l'index de ce point dans pointsList
                for (int i = 0; i < pointsList.Count; i++)
                {
                    if (Math.Abs(pointsList[i].x - jumpPoint.x) < 0.01 && 
                        Math.Abs(pointsList[i].y - jumpPoint.y) < 0.01)
                    {
                        jumpIndices.Add(i);
                        break;
                    }
                }
            }
        }
        
        // Appliquer le filtre par lignes si activé
        HashSet<int> lineFilteredIndices = null;
        bool hasLineFilter = filterByLines && selectedLines.Count > 0 && selectedLines.Count < totalLines;
        
        if (hasLineFilter)
        {
            lineFilteredIndices = GetLineIndicesForPoints(pointsList, jumpGroups);
        }
        
        // Calculer les distances entre points consécutifs et créer les segments
        var segments = new List<object>();
        
        for (int i = 0; i < pointsList.Count - 1; i++)
        {
            // Vérifier si filtré par lignes
            bool isFiltered = lineFilteredIndices != null && 
                             !lineFilteredIndices.Contains(i) && 
                             !lineFilteredIndices.Contains(i + 1);
            
            bool isJump = jumpIndices.Contains(i) || jumpIndices.Contains(i + 1);
            
            // Skip si : filtré par lignes OU (hideJumps activé ET c'est un saut)
            if (isFiltered || (hideJumps && isJump))
                continue;
            
            var p1 = pointsList[i];
            var p2 = pointsList[i + 1];
            
            // Calculer la distance euclidienne entre les deux points
            double distance = Math.Sqrt(Math.Pow(p2.x - p1.x, 2) + Math.Pow(p2.y - p1.y, 2));
            
            // Calculer l'épaisseur en fonction de la distance
            double lineWidth;
            
            if (distance < 10)
                lineWidth = 50;
            else if (distance < 30)
                lineWidth = 30;
            else if (distance < 70)
                lineWidth = 10;
            else if (distance < 150)
                lineWidth = 5;
            else
                lineWidth = 1;
            
            // Si ce n'est pas un saut, utiliser la couleur normale, sinon bleu (seulement si hideJumps pas activé et pas de filtre par lignes actif)
            string segmentColor = (!hideJumps && !hasLineFilter && isJump) ? "blue" : lineColor;
            
            segments.Add(new
            {
                x1 = p1.x,
                y1 = p1.y,
                x2 = p2.x,
                y2 = p2.y,
                width = lineWidth,
                color = segmentColor
            });
        }
        
        // Dessiner les segments avec épaisseur variable
        await JS.InvokeVoidAsync("drawThickenedLineWithColors", segments);
        
        // Dessiner les points par-dessus (sauf les sauts si hideJumps et sauf les points filtrés par lignes)
        for (int i = 0; i < pointsList.Count; i++)
        {
            bool isFiltered = lineFilteredIndices != null && !lineFilteredIndices.Contains(i);
            bool isJump = jumpIndices.Contains(i);
            
            // Skip si : filtré par lignes OU (hideJumps activé ET c'est un saut)
            if (isFiltered || (hideJumps && isJump))
                continue;
            
            var point = pointsList[i];
            string color = (!hideJumps && !hasLineFilter && isJump) ? "blue" : pointColor;
            await JS.InvokeVoidAsync("drawPoint", point.x, point.y, color, 4);
        }
    }
    
    // ------------------- MÉTHODES UTILITAIRES POUR LE TABLEAU -------------------
    
    // ------------------- MÉTHODES POUR LE FILTRE PAR LIGNES -------------------
    
    private HashSet<int> GetLineIndicesForPoints(List<(double x, double y)> pointsList, List<List<(double x, double y)>> jumpGroups)
    {
        // Créer une map point index -> numéro de ligne
        var pointLineMap = new Dictionary<int, int>();
        
        // Créer un set des indices de sauts
        var jumpIndices = new HashSet<int>();
        foreach (var group in jumpGroups)
        {
            foreach (var jumpPoint in group)
            {
                for (int i = 0; i < pointsList.Count; i++)
                {
                    if (Math.Abs(pointsList[i].x - jumpPoint.x) < 0.01 && 
                        Math.Abs(pointsList[i].y - jumpPoint.y) < 0.01)
                    {
                        jumpIndices.Add(i);
                        break;
                    }
                }
            }
        }
        
        // Assigner les numéros de ligne
        int currentLine = 1;
        for (int i = 0; i < pointsList.Count; i++)
        {
            if (!jumpIndices.Contains(i))
            {
                pointLineMap[i] = currentLine;
            }
            else
            {
                // Point de saut - passe à la ligne suivante après ce groupe
                if (i > 0 && !jumpIndices.Contains(i - 1))
                {
                    currentLine++;
                }
            }
        }
        
        // Retourner les indices des points qui appartiennent aux lignes sélectionnées
        var result = new HashSet<int>();
        foreach (var kvp in pointLineMap)
        {
            if (selectedLines.Contains(kvp.Value))
            {
                result.Add(kvp.Key);
            }
        }
        
        return result;
    }
    
    private void ToggleLine(int lineNumber, bool isChecked)
    {
        if (isChecked)
        {
            selectedLines.Add(lineNumber);
        }
        else
        {
            selectedLines.Remove(lineNumber);
        }
        
        UpdateOverlay();
    }
    
    private void SelectAllLines()
    {
        selectedLines.Clear();
        for (int i = 1; i <= totalLines; i++)
        {
            selectedLines.Add(i);
        }
        
        UpdateOverlay();
    }
    
    private void DeselectAllLines()
    {
        selectedLines.Clear();
        UpdateOverlay();
    }
    
    private void CalculateTotalLines()
    {
        // Le nombre de lignes est déterminé par les sauts dans cleaned.csv
        // Une ligne = portion entre deux sauts consécutifs
        totalLines = 0;
        
        if (jumpGroupsRaw != null && jumpGroupsRaw.Count > 0)
        {
            // Nombre de lignes = nombre de groupes de sauts + 1
            // (car il y a une ligne avant le premier saut, entre chaque groupe, et après le dernier)
            totalLines = jumpGroupsRaw.Count + 1;
        }
        else if (pointsCleaned != null && pointsCleaned.Count > 0)
        {
            // Si pas de sauts, considérer qu'il y a une seule ligne
            totalLines = 1;
        }
        
        // Alternativement, utiliser le nombre de lignes depuis resultats_ocr
        if (resultats != null && resultats.Count > 0)
        {
            var maxLigne = resultats.Max(r => r.ligne);
            if (maxLigne > totalLines)
            {
                totalLines = maxLigne;
            }
        }
        
        // Initialiser toutes les lignes comme sélectionnées par défaut
        selectedLines.Clear();
        for (int i = 1; i <= totalLines; i++)
        {
            selectedLines.Add(i);
        }
    }
    
    // ------------------- MÉTHODES UTILITAIRES POUR LE TABLEAU -------------------
    
    private IEnumerable<Resultat> GetFilteredWords()
    {
        if (resultats == null) return Enumerable.Empty<Resultat>();
        
        return selectedWordFilter == 1 
            ? resultats.Where(r => r.nbMot > 0) // Mots lus uniquement
            : resultats; // Tous les mots
    }
    
    private double CalculerPourcentageLecture(int nbPoints)
    {
        if (nbPoints == 0) return 0;
        
        // Calcul basé sur une échelle : 
        // 0 points = 0%, 1-2 points = 20%, 3-5 points = 50%, 6-10 points = 75%, 10+ points = 100%
        if (nbPoints >= 10) return 100;
        if (nbPoints >= 6) return 75;
        if (nbPoints >= 3) return 50;
        if (nbPoints >= 1) return 20;
        return 0;
    }
    
    private string GetProgressColor(double pourcentage)
    {
        if (pourcentage >= 75) return "#28a745"; // Vert
        if (pourcentage >= 50) return "#ffc107"; // Jaune
        if (pourcentage >= 20) return "#fd7e14"; // Orange
        return "#dc3545"; // Rouge
    }
    
    private BadgeStyle GetBadgeStyle(int nbPoints)
    {
        if (nbPoints == 0) return BadgeStyle.Light;
        if (nbPoints <= 2) return BadgeStyle.Info;
        if (nbPoints <= 5) return BadgeStyle.Primary;
        if (nbPoints <= 10) return BadgeStyle.Warning;
        return BadgeStyle.Danger;
    }
    
    // ------------------- DATA LOADING -------------------
    private static List<T> ReadCsv<T>(string path, CsvConfiguration config)
    {
        using var reader = new StreamReader(path);
        using var csv = new CsvReader(reader, config);
        return csv.GetRecords<T>().ToList();
    }
    

@page "/show-data/{readingId}"
@rendermode InteractiveServer
@using System.Globalization
@using VisuLecture.Components.Controller
@using VisuLecture.Components.Model
@using Microsoft.EntityFrameworkCore
@using CsvHelper
@using CsvHelper.Configuration
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject AppDbContext Db
@inject NavigationManager Navigation
@inject IWebHostEnvironment Env

<div class="data-viewer-container">
    
    <!-- Hero Section -->
    <section class="data-hero">
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <h1 class="page-title">
                <RadzenIcon Icon="visibility" style="margin-right: 15px; font-size: inherit;" />
                Analyse du parcours visuel
            </h1>
            @if (showedStudent != null && textRecord != null)
            {
                <p class="page-subtitle">
                    <strong>@showedStudent.FirstName @showedStudent.LastName</strong> - @textRecord.Name
                </p>
            }
        </div>
    </section>

    <!-- Controls Section -->
    <section class="controls-section">
        <div class="section-container">
            <!-- Statistiques Section -->
            @if (resultats != null)
            {
                <div class="stats-card">
                    <div class="stats-header">
                        <RadzenIcon Icon="analytics" style="margin-right: 10px; font-size: 1.5rem;" />
                        <h3 class="stats-title">Statistiques de lecture</h3>
                    </div>
                    <div class="stats-content">
                        <div class="stat-item">
                            <div class="stat-label">Total mots</div>
                            <div class="stat-value">@totalMots</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Mots lus</div>
                            <div class="stat-value stat-success">@motsLus</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Mots non lus</div>
                            <div class="stat-value stat-warning">@motsNonLus</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Pourcentage lu</div>
                            <div class="stat-value">@pourcentageLu.ToString("0.00")%</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Moyenne fixations / mot</div>
                            <div class="stat-value">@moyenneFixations.ToString("0.00")</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Durée moyenne fixation</div>
                            <div class="stat-value">@moyenneDureeFixation.ToString("0.000") s</div>
                        </div>
                        <div class="stat-item">
                            <div class="stat-label">Vitesse de lecture</div>
                            <div class="stat-value stat-primary">@vitesseLecture mots/min</div>
                        </div>
                    </div>
                </div>
            }
            
            <div class="controls-card">
                <div class="controls-header">
                    <RadzenIcon Icon="tune" style="margin-right: 10px; font-size: 1.5rem;" />
                    <h3 class="controls-title">Contrôles de visualisation</h3>
                </div>
                
                <div class="controls-content">
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isRawVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données calibrées" class="control-label green-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isAffineVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données brutes" class="control-label red-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isDensityVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Ronds de densité" class="control-label purple-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isWordBoxVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Boîtes autour des mots" class="control-label cyan-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenButton Click="@GoBack" class="btn-back">
                            <RadzenIcon Icon="arrow_back" style="margin-right: 5px;" />
                            Retour
                        </RadzenButton>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Visualization Section -->
    <section class="visualization-section">
        <div class="section-container">
            <div class="image-container">
                @if (textRecord != null)
                {
                    <RadzenImage Path="@(textRecord.FilePath + "/image.png")"
                                 Attributes="@(new Dictionary<string, object>
                                             {
                                                 { "id", "backgroundImage" },
                                                 { "class", "calibration-image" }
                                             })" />
                }
                <canvas id="overlayCanvas"></canvas>
            </div>
        </div>
    </section>
    
</div>

@code {
    // ------------------- CLASSES -------------------
    public record MotCsv(string mot, double? x, double? y, double? largeur, double? hauteur, int ligne, string espace, double? confiance);
    public record PointCsv(double timestamp, double x, double y, double jump);

    public class Resultat
    {
        public string mot { get; set; }
        public double x { get; set; }
        public double y { get; set; }
        public double largeur { get; set; }
        public double hauteur { get; set; }
        public int nbMot { get; set; }
        public int retourArriere { get; set; }
        public double tempsFixation { get; set; }
        public int ligne { get; set; }
    }

    // ------------------- VARIABLES -------------------
    private List<(double x, double y)> points = new();
    private List<(double x, double y)> pointsRaw = new();
    private bool isAffineVisible = false;
    private bool isRawVisible = false;
    private bool isDensityVisible = false;
    private bool isWordBoxVisible = false;
    [Parameter] public string readingId { get; set; }
    
    private Reading reading;
    private Student showedStudent;
    private TextRecord textRecord;
    
    // Variables d'analyse
    private List<Resultat> resultats;
    private int totalMots;
    private int motsLus;
    private int motsNonLus;
    private double pourcentageLu;
    private double moyenneFixations;
    private double moyenneDureeFixation;
    private int vitesseLecture;
    
    private async Task UpdateOverlay()
    {
        await JS.InvokeVoidAsync("clearOverlay");
        
        // Dessiner les ronds de densité EN PREMIER (pour qu'ils soient en arrière-plan)
        if (isDensityVisible && resultats != null && resultats.Count > 0)
        {
            await DrawDensityCircles();
        }
        
        // Dessiner les boîtes autour des mots
        if (isWordBoxVisible && resultats != null && resultats.Count > 0)
        {
            await DrawWordBoxes();
        }
        
        // Dessiner les courbes PAR-DESSUS
        if (isRawVisible && pointsRaw != null && pointsRaw.Count > 0)
        {
            var jsPointsRaw = pointsRaw.Select(p => new { x = p.x, y = p.y }).ToList();
            await JS.InvokeVoidAsync("drawFollowLine", jsPointsRaw, "red", "blue");
        }
        
        if (isAffineVisible && points != null && points.Count > 0)
        {
            var jsPoints = points.Select(p => new { x = p.x, y = p.y }).ToList();
            await JS.InvokeVoidAsync("drawFollowLine", jsPoints, "green", "yellow");
        }
    }

    private async Task DrawDensityCircles()
    {
        foreach (var r in resultats)
        {
            if (r.nbMot > 0)
            {
                // Centre du mot
                double centerX = r.x + r.largeur / 2;
                double centerY = r.y + r.hauteur / 2;
                
                // Rayon basé sur le nombre de points (fixations)
                double baseRadius = 15;
                double radius = baseRadius + (r.nbMot * 2);
                
                // Opacité basée sur le nombre de points (augmentée pour meilleure visibilité)
                double opacity = Math.Min(0.4 + (r.nbMot * 0.06), 0.85);
                
                // Couleur en fonction de l'intensité (du vert au rouge)
                string color;
                if (r.nbMot <= 5)
                    color = $"rgba(0, 255, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Vert
                else if (r.nbMot <= 15)
                    color = $"rgba(255, 165, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Orange
                else
                    color = $"rgba(255, 0, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Rouge
                
                await JS.InvokeVoidAsync("drawDensityCircle", centerX, centerY, radius, color);
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Charger la lecture avec ses relations
        reading = await Db.Readings
            .Include(r => r.Student)
            .Include(r => r.TextRecord)
            .FirstOrDefaultAsync(r => r.Id == readingId);
        
        if (reading == null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail = "Enregistrement introuvable"
            });
            return;
        }
        
        showedStudent = reading.Student;
        textRecord = reading.TextRecord;
        
        var csvPath = "records/" + readingId + "/raw.csv";
        var csvRaw = "records/" + readingId + "/cleaned.csv";

        if (!File.Exists(csvPath))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "CSV manquant",
                Detail = $"Fichier introuvable : {csvPath}"
            });
            return;
        }

        var csv = await File.ReadAllLinesAsync(csvPath);

        points.Clear();

        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line))
                continue;

            var parts = line.Split(',');
            if (parts.Length < 3)
                continue;

            // index,x,y  -> x = parts[1], y = parts[2]
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                points.Add((x, y));
            }
            else
            {
                // Optionnel : log / notify pour les lignes malformées
                Console.WriteLine($"Ligne CSV ignorée (parse failed): {line}");
            }
        }
        
        csv = await File.ReadAllLinesAsync(csvRaw);

        pointsRaw.Clear();

        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line))
                continue;

            var parts = line.Split(',');
            if (parts.Length < 3)
                continue;

            // index,x,y  -> x = parts[1], y = parts[2]
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                pointsRaw.Add((x, y));
            }
            else
            {
                // Optionnel : log / notify pour les lignes malformées
                Console.WriteLine($"Ligne CSV ignorée (parse failed): {line}");
            }
        }
        
        // Effectuer l'analyse des mots
        await AnalyseFichiers();
    }
    
    // ------------------- ANALYSE -------------------
    private async Task AnalyseFichiers()
    {
        if (textRecord == null) return;
        
        string pathMots = Path.Combine(Env.WebRootPath, textRecord.FilePath, "resultats_ocr.csv");
        string pathPoints = Path.Combine(Env.ContentRootPath, "records", readingId, "cleaned.csv");

        // Vérifier que les fichiers existent
        if (!File.Exists(pathMots))
        {
            Console.WriteLine($"Fichier OCR introuvable : {pathMots}");
            return;
        }
        
        if (!File.Exists(pathPoints))
        {
            Console.WriteLine($"Fichier points introuvable : {pathPoints}");
            return;
        }

        var config = new CsvConfiguration(CultureInfo.InvariantCulture)
        {
            Delimiter = ",",
            Encoding = System.Text.Encoding.UTF8,
            HeaderValidated = null,
            MissingFieldFound = null
        };

        try
        {
            // --- Lecture fichiers ---
            var motsCsv = ReadCsv<MotCsv>(pathMots, config);
            var pointsCsv = ReadCsv<PointCsv>(pathPoints, config)
                .OrderBy(p => p.timestamp)
                .ToList();

            totalMots = motsCsv.Count;
            resultats = new();

            const double margeX = 15;
            const double margeY = 15;

            // --- Analyse de chaque mot ---
            foreach (var m in motsCsv)
            {
                double x = m.x ?? 0;
                double y = m.y ?? 0;
                double w = m.largeur ?? 10;
                double h = m.hauteur ?? 10;

                double xmin = x - margeX;
                double xmax = x + w + margeX;
                double ymin = y - margeY;
                double ymax = y + h + margeY;

                var pts = pointsCsv
                    .Where(p => p.x >= xmin && p.x <= xmax && p.y >= ymin && p.y <= ymax)
                    .ToList();

                int nb = pts.Count;

                // Retours arrière
                int retours = 0;
                for (int i = 1; i < pts.Count; i++)
                    if (pts[i].x < pts[i - 1].x) retours++;

                // Durée fixation
                double duree =
                    nb > 1 ? pts.Last().timestamp - pts.First().timestamp :
                    nb == 1 ? 0.05 : 0;

                // Résultat
                resultats.Add(new Resultat
                {
                    mot = m.mot,
                    x = x,
                    y = y,
                    largeur = w,
                    hauteur = h,
                    nbMot = nb,
                    retourArriere = retours,
                    tempsFixation = Math.Round(duree, 3),
                    ligne = m.ligne
                });
            }

            // --- Statistiques ---
            motsLus = resultats.Count(r => r.nbMot > 0);
            motsNonLus = totalMots - motsLus;
            pourcentageLu = totalMots > 0 ? 100.0 * motsLus / totalMots : 0;

            var lus = resultats.Where(r => r.nbMot > 0).ToList();

            moyenneFixations = lus.Any() ? lus.Average(r => r.nbMot) : 0;
            moyenneDureeFixation = lus.Any() ? lus.Average(r => r.tempsFixation) : 0;

            double tempsTotal = lus.Sum(r => r.tempsFixation);
            vitesseLecture = tempsTotal > 0 ? (int)(motsLus / (tempsTotal / 60.0)) : 0;
            
            Console.WriteLine($"Analyse terminée : {motsLus}/{totalMots} mots lus");
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Erreur lors de l'analyse : {ex.Message}");
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur d'analyse",
                Detail = $"Impossible d'analyser les fichiers : {ex.Message}"
            });
        }
    }

    private async Task DrawWordBoxes()
    {
        foreach (var r in resultats)
        {
            // Dessiner une boîte pour chaque mot (lu ou non)
            // Couleur différente selon si le mot a été lu ou non
            string borderColor;
            double opacity;
            
            if (r.nbMot > 0)
            {
                // Mot lu - couleur en fonction de l'intensité
                opacity = 0.8;
                if (r.nbMot <= 5)
                    borderColor = $"rgba(0, 200, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Vert
                else if (r.nbMot <= 15)
                    borderColor = $"rgba(255, 165, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Orange
                else
                    borderColor = $"rgba(255, 0, 0, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})"; // Rouge
            }
            else
            {
                // Mot non lu - gris semi-transparent
                opacity = 0.5;
                borderColor = $"rgba(150, 150, 150, {opacity.ToString(System.Globalization.CultureInfo.InvariantCulture)})";
            }
            
            await JS.InvokeVoidAsync("drawWordBox", r.x, r.y, r.largeur, r.hauteur, borderColor);
        }
    }
    
    // ------------------- DATA LOADING -------------------
    private static List<T> ReadCsv<T>(string path, CsvConfiguration config)
    {
        using var reader = new StreamReader(path);
        using var csv = new CsvReader(reader, config);
        return csv.GetRecords<T>().ToList();
    }
    
    private void GoBack()
    {
        Navigation.NavigateTo("/teacher-panel");
    }
}


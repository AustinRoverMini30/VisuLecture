@page "/show-data/{readingId}"
@rendermode InteractiveServer
@using System.Globalization
@using VisuLecture.Components.Controller
@using VisuLecture.Components.Model
@using Microsoft.EntityFrameworkCore
@inject NotificationService NotificationService
@inject IJSRuntime JS
@inject AppDbContext Db
@inject NavigationManager Navigation

<div class="data-viewer-container">
    
    <!-- Hero Section -->
    <section class="data-hero">
        <div class="hero-gradient"></div>
        <div class="hero-content">
            <h1 class="page-title">
                <RadzenIcon Icon="visibility" style="margin-right: 15px; font-size: inherit;" />
                Analyse du parcours visuel
            </h1>
            @if (showedStudent != null && textRecord != null)
            {
                <p class="page-subtitle">
                    <strong>@showedStudent.FirstName @showedStudent.LastName</strong> - @textRecord.Name
                </p>
            }
        </div>
    </section>

    <!-- Controls Section -->
    <section class="controls-section">
        <div class="section-container">
            <div class="controls-card">
                <div class="controls-header">
                    <RadzenIcon Icon="tune" style="margin-right: 10px; font-size: 1.5rem;" />
                    <h3 class="controls-title">Contrôles de visualisation</h3>
                </div>
                
                <div class="controls-content">
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isRawVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données calibrées" class="control-label green-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenCheckBox @bind-Value=@isAffineVisible Change="@UpdateOverlay" TValue="bool" />
                        <RadzenLabel Text="Données brutes" class="control-label red-label" />
                    </div>
                    
                    <div class="control-group">
                        <RadzenButton Click="@GoBack" class="btn-back">
                            <RadzenIcon Icon="arrow_back" style="margin-right: 5px;" />
                            Retour
                        </RadzenButton>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <!-- Visualization Section -->
    <section class="visualization-section">
        <div class="section-container">
            <div class="image-container">
                @if (textRecord != null)
                {
                    <RadzenImage Path="@(textRecord.FilePath + "/image.png")"
                                 Attributes="@(new Dictionary<string, object>
                                             {
                                                 { "id", "backgroundImage" },
                                                 { "class", "calibration-image" }
                                             })" />
                }
                <canvas id="overlayCanvas"></canvas>
            </div>
        </div>
    </section>
    
</div>

@code {
    private List<(double x, double y)> points = new();
    private List<(double x, double y)> pointsRaw = new();
    private bool isAffineVisible = false;
    private bool isRawVisible = false;
    [Parameter] public string readingId { get; set; }
    
    private Reading reading;
    private Student showedStudent;
    private TextRecord textRecord;
    
    private async Task UpdateOverlay()
    {
        await JS.InvokeVoidAsync("clearOverlay");
        
        // Dessiner les courbes actives
        if (isRawVisible && pointsRaw != null && pointsRaw.Count > 0)
        {
            var jsPointsRaw = pointsRaw.Select(p => new { x = p.x, y = p.y }).ToList();
            await JS.InvokeVoidAsync("drawFollowLine", jsPointsRaw, "red", "blue");
        }
        
        if (isAffineVisible && points != null && points.Count > 0)
        {
            var jsPoints = points.Select(p => new { x = p.x, y = p.y }).ToList();
            await JS.InvokeVoidAsync("drawFollowLine", jsPoints, "green", "yellow");
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Charger la lecture avec ses relations
        reading = await Db.Readings
            .Include(r => r.Student)
            .Include(r => r.TextRecord)
            .FirstOrDefaultAsync(r => r.Id == readingId);
        
        if (reading == null)
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Error,
                Summary = "Erreur",
                Detail = "Enregistrement introuvable"
            });
            return;
        }
        
        showedStudent = reading.Student;
        textRecord = reading.TextRecord;
        
        var csvPath = "records/" + readingId + "/raw.csv";
        var csvRaw = "records/" + readingId + "/cleaned.csv";

        if (!File.Exists(csvPath))
        {
            NotificationService.Notify(new NotificationMessage
            {
                Severity = NotificationSeverity.Warning,
                Summary = "CSV manquant",
                Detail = $"Fichier introuvable : {csvPath}"
            });
            return;
        }

        var csv = await File.ReadAllLinesAsync(csvPath);

        points.Clear();

        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line))
                continue;

            var parts = line.Split(',');
            if (parts.Length < 3)
                continue;

            // index,x,y  -> x = parts[1], y = parts[2]
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                points.Add((x, y));
            }
            else
            {
                // Optionnel : log / notify pour les lignes malformées
                Console.WriteLine($"Ligne CSV ignorée (parse failed): {line}");
            }
        }
        
        csv = await File.ReadAllLinesAsync(csvRaw);

        pointsRaw.Clear();

        foreach (var raw in csv.Skip(1)) // skip header
        {
            var line = raw?.Trim();
            if (string.IsNullOrEmpty(line))
                continue;

            var parts = line.Split(',');
            if (parts.Length < 3)
                continue;

            // index,x,y  -> x = parts[1], y = parts[2]
            if (double.TryParse(parts[1].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var x) &&
                double.TryParse(parts[2].Trim(), NumberStyles.Any, CultureInfo.InvariantCulture, out var y))
            {
                pointsRaw.Add((x, y));
            }
            else
            {
                // Optionnel : log / notify pour les lignes malformées
                Console.WriteLine($"Ligne CSV ignorée (parse failed): {line}");
            }
        }
    }
    


    private void OnClickDensity(object args)
    {
        NotificationService.Notify(new NotificationMessage
        {
            Severity = NotificationSeverity.Info,
            Summary = "Mode",
            Detail = "Densité (non implémenté)"
        });
    }
    
    private void GoBack()
    {
        Navigation.NavigateTo("/teacher-panel");
    }
}

<style>
    .data-viewer-container {
        min-height: 100vh;
        background: linear-gradient(135deg, #F7F5E8 0%, #E8E6D9 100%);
    }

    /* Hero Section */
    .data-hero {
        position: relative;
        padding: 4rem 2rem 3rem;
        background: linear-gradient(135deg, #1d0050 0%, #3a0099 100%);
        overflow: hidden;
    }

    .hero-gradient {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: radial-gradient(circle at top right, rgba(255, 255, 255, 0.1), transparent);
        pointer-events: none;
    }

    .hero-content {
        position: relative;
        z-index: 1;
        max-width: 1200px;
        margin: 0 auto;
        text-align: center;
    }

    .page-title {
        font-family: 'Eurostile', sans-serif;
        font-size: 3rem;
        color: white;
        margin: 0 0 1rem 0;
        display: flex;
        align-items: center;
        justify-content: center;
        text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.2);
    }

    .page-subtitle {
        font-size: 1.3rem;
        color: rgba(255, 255, 255, 0.9);
        margin: 0;
    }

    /* Controls Section */
    .controls-section {
        padding: 2rem;
        background: transparent;
    }

    .section-container {
        max-width: 1200px;
        margin: 0 auto;
    }

    .controls-card {
        background: white;
        border-radius: 15px;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
        overflow: hidden;
        transition: transform 0.3s ease, box-shadow 0.3s ease;
    }

    .controls-card:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 30px rgba(0, 0, 0, 0.12);
    }

    .controls-header {
        display: flex;
        align-items: center;
        padding: 1.5rem;
        background: linear-gradient(135deg, #f8f9fa 0%, #e9ecef 100%);
        border-bottom: 2px solid #dee2e6;
    }

    .controls-title {
        font-family: 'Eurostile', sans-serif;
        font-size: 1.3rem;
        color: #1d0050;
        margin: 0;
    }

    .controls-content {
        padding: 1.5rem;
        display: flex;
        gap: 2rem;
        flex-wrap: wrap;
        align-items: center;
    }

    .control-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
    }

    .control-label {
        font-size: 1.1rem;
        font-weight: 500;
        color: #333;
        margin: 0 !important;
    }

    .green-label {
        color: #28a745 !important;
    }

    .red-label {
        color: #dc3545 !important;
    }

    .btn-back {
        background: linear-gradient(135deg, #1d0050 0%, #3a0099 100%);
        border: none;
        padding: 0.75rem 1.5rem;
        font-size: 1rem;
        font-weight: 600;
        border-radius: 8px;
        transition: all 0.3s ease;
        display: flex;
        align-items: center;
        gap: 0.5rem;
    }

    .btn-back:hover {
        background: linear-gradient(135deg, #2a0070 0%, #4a00bb 100%);
        transform: translateY(-2px);
        box-shadow: 0 4px 15px rgba(29, 0, 80, 0.3);
    }

    /* Visualization Section */
    .visualization-section {
        padding: 2rem;
    }

    .image-container {
        position: relative;
        width: 100%;
        background: white;
        border-radius: 15px;
        overflow: hidden;
        box-shadow: 0 4px 20px rgba(0, 0, 0, 0.08);
    }

    .calibration-image {
        width: 100%;
        display: block;
    }

    #overlayCanvas {
        position: absolute;
        left: 0;
        top: 0;
        pointer-events: none;
    }

    /* Animations */
    @@keyframes fadeIn {
        from {
            opacity: 0;
            transform: translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .data-viewer-container {
        animation: fadeIn 0.5s ease-out;
    }

    /* Responsive */
    @@media (max-width: 768px) {
        .data-hero {
            padding: 2rem 1rem;
        }

        .page-title {
            font-size: 2rem;
        }

        .page-subtitle {
            font-size: 1rem;
        }

        .controls-content {
            flex-direction: column;
            gap: 1rem;
            align-items: flex-start;
        }

        .control-group {
            width: 100%;
        }

        .visualization-section {
            padding: 1rem;
        }
    }
</style>

